<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>baranggaysystem1</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="FontAwesome.Sharp" Version="6.6.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="MySql.Data" Version="9.6.0" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <PackageReference Include="QuestPDF" Version="2026.2.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="baranggaysystem1\Database\sqlite\offline_bootstrap.sql" Link="Database\sqlite\offline_bootstrap.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="baranggaysystem1\Database\sqlite\seed_demo_data.sql" Link="Database\sqlite\seed_demo_data.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="baranggaysystem1\Database\sqlite\barangay_system.db" Link="Database\sqlite\barangay_system.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="baranggaysystem1\Database\migrations\*" Link="Database\migrations\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="baranggaysystem1\Database\sqlite\*.sql" />
    <EmbeddedResource Include="baranggaysystem1\Database\migrations\*.sql" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="baranggaysystem1\Resources\dashboard-dark-bg.png" Link="Resources\dashboard-dark-bg.png" />
    <Resource Include="baranggaysystem1\Resources\barangaybg.jpg" Link="Resources\barangaybg.jpg" />
    <Resource Include="baranggaysystem1\Resources\tech.png" Link="Resources\tech.png" />
    <Resource Include="baranggaysystem1\Resources\app_logo.png" Link="Resources\app_logo.png" />
    <Resource Include="baranggaysystem1\Resources\app.ico" Link="Resources\app.ico" />
  </ItemGroup>
</Project>
