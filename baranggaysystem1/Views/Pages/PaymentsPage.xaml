<UserControl x:Class="baranggaysystem1.Views.Pages.PaymentsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="Transparent" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="44" Height="44" CornerRadius="10" Background="#3322C55E" Margin="0,0,14,0">
            <fa:IconBlock Icon="MoneyBillWave" Foreground="#22C55E" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Resident Payments" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Name="recordCountLabel" Text="Tracking resident service payments and official receipts." Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Export CSV" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" MinWidth="110" Click="BtnExportCsv_Click" />
          <Button Content="Record Payment" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" Click="BtnAdd_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource ThemeCardBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1" Height="36">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="13" Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox Name="searchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,6,0" TextChanged="SearchBox_TextChanged" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
          <ComboBox Name="typeFilter" Height="36" Width="170" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" />
          <ComboBox Name="methodFilter" Margin="8,0,0,0" Height="36" Width="140" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" />
          <ComboBox Name="statusFilter" Margin="8,0,0,0" Height="36" Width="130" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" />
        </StackPanel>
        <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Height="36" MinWidth="0" Padding="12,0" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh Ledger" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource ThemeCardBrush}" Margin="20,14,20,0" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" ClipToBounds="True">
      <Grid>
        <DataGrid Name="mainGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource StyledDataGridRowStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="MainGrid_SelectionChanged" />
        <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <fa:IconBlock Icon="CreditCard" FontSize="48" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
          <TextBlock Name="emptyLabel" Text="No payment history found for current filters." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Name="contextActionBar" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource ThemeCardHoverBrush}" Margin="20,10,20,0" Padding="16,10" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <fa:IconBlock Icon="Clock" Foreground="#22C55E" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Text="Actions for:" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBlock Name="selectedRecordLabel" Text="OR-000001" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="6,0,20,0" />
          <Button Name="btnPrintOR" Content="Print Receipt" Style="{StaticResource ContextualActionButtonStyle}" Margin="0,0,8,0" Click="BtnPrintOR_Click" />
          <Button Name="btnViewDetails" Content="View Details" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Click="BtnView_Click" />
          <Button Name="btnVoid" Content="Void Payment" Style="{StaticResource ActionButtonStyle}" Click="BtnVoid_Click" />
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GhostButtonStyle}" Content="Close" Padding="8,4" Foreground="{DynamicResource ThemeTextMutedBrush}" Click="BtnClearSelection_Click" />
      </Grid>
    </Border>
    <Border Grid.Row="4" Margin="20,10,20,14" Background="Transparent" Height="38">
      <Grid>
        <TextBlock Name="footerCountLabel" Text="0 records loaded." Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Name="ledgerSummaryLabel" Text="Valid collection: PHP 0.00  ·  0 void" Style="{StaticResource SmallTextStyle}" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
