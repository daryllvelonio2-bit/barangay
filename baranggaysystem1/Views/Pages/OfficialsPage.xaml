<UserControl x:Class="baranggaysystem1.Views.Pages.OfficialsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="Transparent">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <StackPanel>
          <TextBlock Text="Barangay Officials" Style="{StaticResource HeadingTextStyle}" />
          <TextBlock Name="recordCountLabel" Text="Appointments, terms, and status" Style="{StaticResource SubtitleTextStyle}" />
        </StackPanel>
        <Button HorizontalAlignment="Right" Content="+ New Appointment" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAdd_Click" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox Name="searchBox" Height="36" Padding="10,0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Search official, position, or committee" />
        <ComboBox Name="statusFilter" Grid.Column="1" Height="36" Margin="10,0,0,0" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged">
          <ComboBoxItem Content="All Statuses" IsSelected="True" />
          <ComboBoxItem Content="ACTIVE" />
          <ComboBoxItem Content="INACTIVE" />
        </ComboBox>
        <Button Grid.Column="3" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Click="BtnRefresh_Click" />
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource ThemeCardBrush}" Margin="20,14,20,16" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" ClipToBounds="True">
      <Grid>
        <!-- Hidden elements preserved for code-behind compatibility -->
        <StackPanel Visibility="Collapsed">
          <Border Name="contextActionBar">
            <StackPanel>
              <TextBlock Name="selectedRecordLabel" />
              <Button Name="btnStatus" Click="BtnStatus_Click" />
            </StackPanel>
          </Border>
          <TextBlock Name="footerCountLabel" />
        </StackPanel>
        <DataGrid Name="mainGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource StyledDataGridRowStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="MainGrid_SelectionChanged" MouseDoubleClick="MainGrid_DoubleClick">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Edit Official Appointment" Click="BtnEdit_Click">
                <MenuItem.Icon>
                  <fa:IconBlock Icon="Edit" FontSize="12" Foreground="{DynamicResource AccentBlueBrush}" />
                </MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="End / Change Appointment Status" Click="BtnStatus_Click">
                <MenuItem.Icon>
                  <fa:IconBlock Icon="UserTimes" FontSize="12" Foreground="#EF4444" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Official" Binding="{Binding full_name}" Width="*" />
            <DataGridTextColumn Header="Position" Binding="{Binding position}" Width="180" />
            <DataGridTextColumn Header="Committee" Binding="{Binding committee}" Width="200" />
            <DataGridTextColumn Header="Term" Binding="{Binding term_display}" Width="180" />
            <DataGridTextColumn Header="Status" Binding="{Binding status_display}" Width="115" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <fa:IconBlock Icon="UserShield" FontSize="44" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
          <TextBlock Name="emptyLabel" Text="No official appointments found." Style="{StaticResource SubtitleTextStyle}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
