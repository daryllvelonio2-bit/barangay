<UserControl x:Class="baranggaysystem1.Views.Pages.AyudaPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="Transparent" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="AyudaStatCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="Border.Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="MinWidth" Value="126" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04" Direction="270" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="AyudaStatLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
      <Style x:Key="AyudaStatValueStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HeadingTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
      </Style>
      <Style x:Key="AyudaSurfaceCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="16" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.06" Direction="270" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="AyudaSearchShellStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="10" />
        <Setter Property="Height" Value="34" />
      </Style>
      <Style x:Key="AyudaMetaBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
      </Style>
      <Style x:Key="AyudaDataGridRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource StyledDataGridRowStyle}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
          <Trigger Property="DataGridRow.AlternationIndex" Value="1">
            <Setter Property="Background" Value="{DynamicResource ThemeGridRowAltBgBrush}" />
          </Trigger>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource ThemeGridRowHoverBrush}" />
          </Trigger>
          <Trigger Property="DataGridRow.IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource ThemeGridRowSelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeGridRowSelectedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="AyudaDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="AyudaStatusBadgeBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeGridRowHoverBrush}" />
        <Setter Property="BorderBrush" Value="#FFE2E8F0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="10,4" />
        <Style.Triggers>
          <Trigger Property="FrameworkElement.Tag" Value="ACTIVE">
            <Setter Property="Background" Value="#FFDCFCE7" />
            <Setter Property="BorderBrush" Value="#FF86EFAC" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="PAUSED">
            <Setter Property="Background" Value="#FFFEF3C7" />
            <Setter Property="BorderBrush" Value="#FFFCD34D" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="CLOSED">
            <Setter Property="Background" Value="#FFF1F5F9" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="RELEASED">
            <Setter Property="Background" Value="#FFDCFCE7" />
            <Setter Property="BorderBrush" Value="#FF86EFAC" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="CANCELLED">
            <Setter Property="Background" Value="#FFFEE2E2" />
            <Setter Property="BorderBrush" Value="#FFFCA5A5" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="AyudaStatusBadgeTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Style.Triggers>
          <Trigger Property="FrameworkElement.Tag" Value="ACTIVE">
            <Setter Property="Foreground" Value="#FF15803D" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="PAUSED">
            <Setter Property="Foreground" Value="#FFB45309" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="CLOSED">
            <Setter Property="Foreground" Value="#FF475569" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="RELEASED">
            <Setter Property="Foreground" Value="#FF15803D" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="CANCELLED">
            <Setter Property="Foreground" Value="#FFB91C1C" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}" Padding="14,6,14,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="HandsHelping" Foreground="#34D399" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Ayuda &amp; Barangay Assistance" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Name="recordCountLabel" Text=" — Ayuda module unavailable" Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="22,4,0,0">
            <TextBlock Text="Allocated Budget" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock Name="totalBudgetMetric" Text="PHP 0.00" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock Text="Released" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock Name="spentBudgetMetric" Text="PHP 0.00" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock Text="Remaining" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock Name="remainingBudgetMetric" Text="PHP 0.00" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock Text="Beneficiaries" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock Name="beneficiaryMetric" Text="0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Name="btnAddProgram" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" MinWidth="100" Height="28" Padding="8,0" Click="BtnAddProgram_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Wallet" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="New Program" VerticalAlignment="Center" FontSize="11" />
            </StackPanel>
          </Button>
          <Button Name="btnReleaseAyuda" Style="{StaticResource PrimaryButtonStyle}" MinWidth="118" Height="28" Padding="8,0" Click="BtnReleaseAyuda_Click" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="HandHoldingUsd" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Start Distribution" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="11" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}" Padding="14,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource AyudaSearchShellStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Grid Grid.Column="1">
              <TextBox Name="searchBox" Margin="0,0,12,0" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" FontSize="11" TextChanged="SearchBox_TextChanged" />
              <TextBlock Name="searchPlaceholderLabel" Text="Search budget programs" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" IsHitTestVisible="False">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="" Binding="{Binding Text, ElementName=searchBox}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </Grid>
          </Grid>
        </Border>
        <ComboBox Name="programFilter" Visibility="Collapsed" />
        <ComboBox Name="statusFilter" Grid.Column="1" Width="160" Height="34" Margin="10,0,0,0" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" Visibility="Collapsed" />
        <TextBlock Name="workflowStepLabel" Grid.Column="2" Text="Step 1 of 2  •  Choose a budget program" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
        <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Height="32" MinWidth="0" Padding="10,0" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" FontSize="11" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="20,16,20,0">
      <Border Name="programViewPanel" Style="{StaticResource AyudaSurfaceCardStyle}" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource ThemeGridRowAltBgBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Choose an Assistance Budget" Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock Name="programMetaLabel" Text="Click a program to view only its distributions and available actions." Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource AyudaMetaBadgeStyle}" Margin="0">
                <TextBlock Name="programTableVisibleLabel" Text="0 programs" Style="{StaticResource SmallTextStyle}" FontWeight="Bold" />
              </Border>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <DataGrid Name="programGrid" Margin="10,8,10,10" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource AyudaDataGridRowStyle}" CellStyle="{StaticResource AyudaDataGridCellStyle}" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2" RowHeight="70" HeadersVisibility="Column" CanUserAddRows="False" SelectionChanged="ProgramGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Program" Width="2*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,7">
                        <TextBlock Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding [program_name]}" />
                        <TextBlock Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="{Binding [category]}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Allocated" Width="1.15*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding [allocated_budget_display]}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Released" Width="1.15*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Text="{Binding [spent_budget_display]}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Remaining" Width="1.15*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding [remaining_budget_display]}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" Width="1.2*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,6">
                        <Border Style="{StaticResource AyudaStatusBadgeBorderStyle}" HorizontalAlignment="Left" Tag="{Binding [status]}">
                          <TextBlock Style="{StaticResource AyudaStatusBadgeTextStyle}" Text="{Binding [status_display]}" Tag="{Binding [status]}" />
                        </Border>
                        <TextBlock Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="{Binding [schedule_display]}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Name="programEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
              <fa:IconBlock Icon="Wallet" FontSize="38" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
              <TextBlock Name="programEmptyLabel" Text="No ayuda programs found." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
              <TextBlock Text="Create a budget program to begin." Style="{StaticResource SmallTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Name="releaseViewPanel" Style="{StaticResource AyudaSurfaceCardStyle}" ClipToBounds="True" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource ThemeGridRowAltBgBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Height="30" MinWidth="0" Padding="10,0" Margin="0,0,12,0" Click="BtnBackToPrograms_Click">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="ArrowLeft" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="Budgets" FontSize="10.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <StackPanel Grid.Column="1">
                <TextBlock Name="selectedProgramTitleText" Text="Selected Budget" Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock Name="selectedProgramSummaryText" Text="Review this program's distributions." Style="{StaticResource SmallTextStyle}" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource AyudaMetaBadgeStyle}">
                  <TextBlock Name="releaseTableVisibleLabel" Text="0 releases" Style="{StaticResource SmallTextStyle}" FontWeight="Bold" />
                </Border>
                <TextBlock Name="releaseTableSelectionLabel" Visibility="Collapsed" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <DataGrid Name="releaseGrid" Margin="10,8,10,10" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource AyudaDataGridRowStyle}" CellStyle="{StaticResource AyudaDataGridCellStyle}" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2" RowHeight="70" HeadersVisibility="Column" CanUserAddRows="False" SelectionChanged="ReleaseGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Reference / Batch" Width="1.55*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,7">
                        <TextBlock Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding [reference_no]}" />
                        <TextBlock Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="{Binding [reference_meta]}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Beneficiary" Width="1.5*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,7">
                        <TextBlock Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding [resident_name]}" />
                        <TextBlock Style="{StaticResource SmallTextStyle}" Margin="0,4,0,0" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="{Binding [resident_meta]}" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Amount" Width="1*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding [amount_display]}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" Width="0.9*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource AyudaStatusBadgeBorderStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Tag="{Binding [release_status]}">
                        <TextBlock Style="{StaticResource AyudaStatusBadgeTextStyle}" Text="{Binding [release_status_display]}" Tag="{Binding [release_status]}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Name="releaseEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
              <fa:IconBlock Icon="HandsHelping" FontSize="38" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
              <TextBlock Name="releaseEmptyLabel" Text="No distributions for this budget." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
              <TextBlock Text="Use Start Distribution when this budget is ready." Style="{StaticResource SmallTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Name="contextActionBar" Grid.Row="3" Margin="20,12,20,16" Padding="14,10" Style="{StaticResource AyudaSurfaceCardStyle}" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Name="footerCountLabel" Text="Choose a budget program." Style="{StaticResource SmallTextStyle}" FontWeight="SemiBold" />
          <TextBlock Name="contextHelpLabel" Text="Only actions for the current selection are shown." Style="{StaticResource SmallTextStyle}" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Name="programActionsPanel" Orientation="Horizontal">
            <Button Name="btnEditProgram" Style="{StaticResource SecondaryButtonStyle}" Height="30" MinWidth="0" Padding="10,0" Margin="0,0,8,0" Click="BtnEditProgram_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="Edit" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Edit Budget" VerticalAlignment="Center" FontSize="11" />
              </StackPanel>
            </Button>
            <Button Name="btnDeleteProgram" Style="{StaticResource SecondaryButtonStyle}" Height="30" MinWidth="0" Padding="10,0" Click="BtnDeleteProgram_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="TrashAlt" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Archive Budget" VerticalAlignment="Center" FontSize="11" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Name="releaseActionsPanel" Orientation="Horizontal" Visibility="Collapsed">
            <Button Name="btnCancelRelease" Style="{StaticResource SecondaryButtonStyle}" Height="30" MinWidth="0" Padding="10,0" Margin="0,0,8,0" Click="BtnCancelRelease_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="Ban" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Reverse Release" VerticalAlignment="Center" FontSize="11" />
              </StackPanel>
            </Button>
            <Button Name="btnOpenReport" Style="{StaticResource SecondaryButtonStyle}" Height="30" MinWidth="0" Padding="10,0" Margin="0,0,8,0" Click="BtnOpenReport_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="FilePdf" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Open Report" VerticalAlignment="Center" FontSize="11" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButtonStyle}" Height="30" MinWidth="0" Padding="8,0" Click="BtnClearReleaseSelection_Click">
              <TextBlock Text="Program Actions" FontSize="10.5" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
