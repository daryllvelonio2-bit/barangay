<UserControl x:Class="baranggaysystem1.Views.Pages.HouseholdsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="Transparent" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="HouseholdSurfaceCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="16" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.06" Direction="270" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="HouseholdHeroChipStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="7,2" />
        <Setter Property="Margin" Value="0,3,5,0" />
      </Style>
      <Style x:Key="HouseholdHeroChipTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="10" />
      </Style>
      <Style x:Key="HouseholdMetricCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource HouseholdSurfaceCardStyle}">
        <Setter Property="Border.Padding" Value="8,6" />
      </Style>
      <Style x:Key="HouseholdMetricLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="9" />
      </Style>
      <Style x:Key="HouseholdMetricValueStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HeadingTextStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
      </Style>
      <Style x:Key="HouseholdSearchShellStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeGridRowAltBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="10" />
        <Setter Property="Height" Value="36" />
      </Style>
      <Style x:Key="HouseholdCompactButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="MinWidth" Value="88" />
      </Style>
      <Style x:Key="HouseholdCompactPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="MinWidth" Value="118" />
      </Style>
      <Style x:Key="HouseholdCompactLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,3" />
      </Style>
      <Style x:Key="HouseholdDataGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource StyledDataGridColumnHeaderStyle}">
        <Setter Property="Background" Value="{DynamicResource ThemeGridHeaderBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeGridHeaderTextBrush}" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
      </Style>
      <Style x:Key="HouseholdDataGridRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource StyledDataGridRowStyle}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
          <Trigger Property="DataGridRow.AlternationIndex" Value="1">
            <Setter Property="Background" Value="{DynamicResource ThemeGridRowAltBgBrush}" />
          </Trigger>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource ThemeGridRowHoverBrush}" />
          </Trigger>
          <Trigger Property="DataGridRow.IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource ThemeGridRowSelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeGridRowSelectedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="HouseholdDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
      </Style>
      <Style x:Key="HouseholdIdBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#336366F1" />
        <Setter Property="BorderBrush" Value="#C7D2FE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="10,4" />
      </Style>
      <Style x:Key="HouseholdPurokBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#3310B981" />
        <Setter Property="BorderBrush" Value="#A7F3D0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="10,4" />
      </Style>
      <Style x:Key="HouseholdMembersBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="10,4" />
      </Style>
      <Style x:Key="HouseholdSelectionMetaStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}" Padding="14,4,14,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,8,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#DDD6FE" Offset="0" />
                <GradientStop Color="#E0F2FE" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <fa:IconBlock Icon="Home" Foreground="#A78BFA" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Household Registry" Style="{StaticResource HeadingTextStyle}" FontSize="13" />
            <TextBlock Name="recordCountLabel" Text="Loading household registry..." Style="{StaticResource SubtitleTextStyle}" FontSize="10" Margin="0,0,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource HouseholdHeroChipStyle}">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Eye" FontSize="9" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" />
              <TextBlock Name="headerVisibleLabel" Text="0 visible" Style="{StaticResource HouseholdHeroChipTextStyle}" Margin="4,0,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource HouseholdHeroChipStyle}">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="MapMarkerAlt" FontSize="9" Foreground="#34D399" VerticalAlignment="Center" />
              <TextBlock Name="headerCoverageLabel" Text="0 puroks" Style="{StaticResource HouseholdHeroChipTextStyle}" Margin="4,0,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource HouseholdHeroChipStyle}">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Users" FontSize="9" Foreground="#F59E0B" VerticalAlignment="Center" />
              <TextBlock Name="headerMembersLabel" Text="0 members" Style="{StaticResource HouseholdHeroChipTextStyle}" Margin="4,0,0,0" />
            </StackPanel>
          </Border>
          <Button Name="btnExportCsv" Style="{StaticResource HouseholdCompactButtonStyle}" Margin="8,0,6,0" MinWidth="80" Height="26">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="FileExport" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="Export" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Content="New Household" Style="{StaticResource HouseholdCompactPrimaryButtonStyle}" MinWidth="110" Height="26" Click="BtnAdd_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <WrapPanel Grid.Row="1" Margin="14,4,14,0" Visibility="Collapsed">
      <Border Style="{StaticResource HouseholdMetricCardStyle}" Width="160" Margin="0,0,6,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="24" Height="24" CornerRadius="8" Background="#336366F1" Margin="0,0,8,0">
            <fa:IconBlock Icon="Home" Foreground="#818CF8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Total Households" Style="{StaticResource HouseholdMetricLabelStyle}" />
            <TextBlock Name="totalHouseholdsMetric" Text="0" Style="{StaticResource HouseholdMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource HouseholdMetricCardStyle}" Width="160" Margin="0,0,6,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="24" Height="24" CornerRadius="8" Background="#330EA5E9" Margin="0,0,8,0">
            <fa:IconBlock Icon="Filter" Foreground="#38BDF8" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Visible Results" Style="{StaticResource HouseholdMetricLabelStyle}" />
            <TextBlock Name="visibleHouseholdsMetric" Text="0" Style="{StaticResource HouseholdMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource HouseholdMetricCardStyle}" Width="160" Margin="0,0,6,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="24" Height="24" CornerRadius="8" Background="#3310B981" Margin="0,0,8,0">
            <fa:IconBlock Icon="Users" Foreground="#34D399" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Listed Members" Style="{StaticResource HouseholdMetricLabelStyle}" />
            <TextBlock Name="totalMembersMetric" Text="0" Style="{StaticResource HouseholdMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource HouseholdMetricCardStyle}" Width="160">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="24" Height="24" CornerRadius="8" Background="#33F59E0B" Margin="0,0,8,0">
            <fa:IconBlock Icon="MapMarkedAlt" Foreground="#FBBF24" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Purok Coverage" Style="{StaticResource HouseholdMetricLabelStyle}" />
            <TextBlock Name="purokCoverageMetric" Text="0" Style="{StaticResource HouseholdMetricValueStyle}" />
          </StackPanel>
        </Grid>
      </Border>
    </WrapPanel>
    <Border Grid.Row="2" Style="{StaticResource HouseholdSurfaceCardStyle}" Margin="14,4,14,0" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.1*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="1.05*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HouseholdSearchShellStyle}" Height="30" VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Grid Column="1">
              <TextBox Name="searchBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="11" Margin="0,0,6,0" TextChanged="SearchBox_TextChanged" />
              <TextBlock Name="searchPlaceholderText" Text="Search household ID, purok, address..." Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0" IsHitTestVisible="False" />
            </Grid>
          </Grid>
        </Border>
        <ComboBox Name="purokFilterCombo" Grid.Column="2" Height="30" MinWidth="130" VerticalAlignment="Center" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="PurokFilterCombo_SelectionChanged" />
        <Border Grid.Column="4" Background="{DynamicResource ThemeCardHoverBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
          <WrapPanel VerticalAlignment="Center">
            <fa:IconBlock Icon="InfoCircle" FontSize="10" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" />
            <TextBlock Name="toolbarInsightLabel" Text="Showing the full household registry." FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
            <TextBlock Name="activeFilterLabel" Text="Filters: All households and all puroks." Style="{StaticResource SmallTextStyle}" FontSize="9.5" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
          </WrapPanel>
        </Border>
        <Button Grid.Column="6" Style="{StaticResource HouseholdCompactButtonStyle}" Height="32" MinWidth="98" Click="BtnClearFilters_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="TimesCircle" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" />
            <TextBlock Text="Clear Filters" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="8" Style="{StaticResource HouseholdCompactButtonStyle}" Height="32" MinWidth="0" Padding="10,0" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh Registry" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="3" Style="{StaticResource HouseholdSurfaceCardStyle}" Margin="14,6,14,0" Padding="0" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Hidden elements referenced by code-behind -->
        <TextBlock Name="tableSummaryLabel" Visibility="Collapsed" />
        <Grid Row="0">
          <DataGrid Name="mainGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource HouseholdDataGridHeaderStyle}" RowStyle="{StaticResource HouseholdDataGridRowStyle}" CellStyle="{StaticResource HouseholdDataGridCellStyle}" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2" RowHeight="40" HeadersVisibility="Column" Margin="6,4,6,6" SelectionChanged="MainGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Household" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="#818CF8" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding [household_id], StringFormat=HH-{0:0000}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Purok" Width="140">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="#34D399" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding [purok_display]}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Address" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource ThemeCardHoverBrush}" Margin="0,0,10,0">
                        <fa:IconBlock Icon="MapMarkerAlt" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel>
                        <TextBlock Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold" Text="{Binding [street_display]}" />
                        <TextBlock Text="Registered street address" Style="{StaticResource SmallTextStyle}" Margin="0,2,0,0" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Members" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource HouseholdMembersBadgeStyle}" HorizontalAlignment="Center">
                      <TextBlock Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="Bold" Text="{Binding [member_count], StringFormat={}{0} member(s)}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Coordinates" Width="180">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource SmallTextStyle}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding [coordinates_display]}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Updated" Width="170">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="16" Text="{Binding [updated_display]}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <Border Width="74" Height="74" CornerRadius="24" Background="{DynamicResource ThemeCardHoverBrush}" Margin="0,0,0,14">
              <fa:IconBlock Icon="Home" FontSize="30" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Name="emptyLabel" Text="No household records found." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
    <Border Name="contextActionBar" Grid.Row="4" Visibility="Collapsed" Margin="20,6,20,0" Padding="10,6" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Background="{DynamicResource ThemeCardBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <fa:IconBlock Icon="Home" Foreground="#818CF8" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Name="selectedRecordLabel" Text="" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
          <TextBlock Name="selectedRecordMetaLabel" Text="" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <Button Name="btnEditDetails" Style="{StaticResource ContextualActionButtonStyle}" Height="26" Padding="8,0" FontSize="10" Margin="0,0,5,0" Click="BtnEditDetails_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Edit" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="Edit" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="10" />
            </StackPanel>
          </Button>
          <Button Name="btnViewMembers" Style="{StaticResource ActionButtonStyle}" Height="26" Padding="8,0" FontSize="10" Margin="0,0,5,0" Click="BtnEdit_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Users" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="Family" VerticalAlignment="Center" FontSize="10" />
            </StackPanel>
          </Button>
          <Button Name="btnTransferHistory" Visibility="Collapsed" Style="{StaticResource ActionButtonStyle}" Height="26" Padding="8,0" FontSize="10" Margin="0,0,5,0" Click="BtnTransferHistory_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="History" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="History" VerticalAlignment="Center" FontSize="10" />
            </StackPanel>
          </Button>
          <Button Name="btnCertificate" Visibility="Collapsed" Style="{StaticResource ActionButtonStyle}" Height="26" Padding="8,0" FontSize="10" Margin="0,0,5,0" Click="BtnCertificate_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="FileAlt" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="Cert" VerticalAlignment="Center" FontSize="10" />
            </StackPanel>
          </Button>
          <Button Name="btnTransfer" Style="{StaticResource ActionButtonStyle}" Height="26" Padding="8,0" FontSize="10" Margin="0,0,5,0" Click="BtnTransfer_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="ExchangeAlt" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="Transfer" VerticalAlignment="Center" FontSize="10" />
            </StackPanel>
          </Button>
          <Button Name="btnDeleteHousehold" Style="{StaticResource DangerButtonStyle}" Height="26" Padding="8,0" FontSize="10" Margin="0,0,5,0" Click="BtnDelete_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="TrashAlt" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="Archive" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="10" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Button Grid.Column="3" Style="{StaticResource GhostButtonStyle}" Padding="2" Width="20" Height="20" Foreground="{DynamicResource ThemeTextMutedBrush}" Click="BtnClearSelection_Click">
          <fa:IconBlock Icon="Times" FontSize="10" />
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="5" Margin="20,6,20,8" Background="Transparent" Height="24">
      <Grid>
        <TextBlock Name="footerCountLabel" Text="0 households loaded." Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Name="lastRefreshLabel" Text="" Style="{StaticResource SmallTextStyle}" Opacity="0.7" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
