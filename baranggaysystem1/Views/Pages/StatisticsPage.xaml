<UserControl x:Class="baranggaysystem1.Views.Pages.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             Background="Transparent">
  <UserControl.Resources>
    <!-- Metric Card with Icon on right -->
    <Style x:Key="MetricCard" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,0,5,5" />
      <Setter Property="MinWidth" Value="108" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.10" Direction="270" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MetricValue" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>
    <Style x:Key="MetricLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="8.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>
    <Style x:Key="IconBubble" TargetType="{x:Type Border}">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style x:Key="ChartCard" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.10" Direction="270" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChartTitle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
      <Setter Property="Margin" Value="0,2,0,6" />
    </Style>

    <!-- Bar Row with gradient bar -->
    <DataTemplate x:Key="BarRowTemplate">
      <Grid Height="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="22" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="1" Background="{DynamicResource ThemeBorderSubtleBrush}" Height="8" CornerRadius="4" VerticalAlignment="Center">
          <Border HorizontalAlignment="Left" CornerRadius="4" Width="{Binding BarWidth}" Height="8">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#7C3AED" Offset="0" />
                <GradientStop Color="#3B82F6" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Border>
        <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat=N0}" FontSize="9"
                   FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="34" Height="34" CornerRadius="9" Background="#22818CF8" Margin="0,0,10,0">
            <fa:IconBlock Icon="ChartBar" Foreground="#818CF8" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Statistics" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Name="lblUpdatedAt" Text="Loading statistics..." FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="Export CSV" Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" MinWidth="90" Height="30" Margin="0,0,6,0" Click="BtnExport_Click" />
        <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" MinWidth="90" Height="30" Click="BtnRefresh_Click" Background="#4F46E5" BorderBrush="#4F46E5">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Content - No Scroll, Fill -->
    <Grid Grid.Row="1" Margin="10,4,10,4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <!-- KPI Rows -->
      <StackPanel Grid.Row="0">

        <!-- COMMUNITY -->
        <TextBlock Text="Community" Style="{StaticResource SectionLabel}" />
        <WrapPanel>
          <Border Style="{StaticResource MetricCard}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Name="valResidents" Text="0" Style="{StaticResource MetricValue}" />
                <TextBlock Text="Total Residents" Style="{StaticResource MetricLabel}" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#33DBEAFE">
                <fa:IconBlock Icon="Users" FontSize="13" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Border Style="{StaticResource MetricCard}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Name="valActive" Text="0" Style="{StaticResource MetricValue}" Foreground="#22C55E" />
                <TextBlock Text="Active" Style="{StaticResource MetricLabel}" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#3322C55E">
                <fa:IconBlock Icon="CheckCircle" FontSize="13" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Border Style="{StaticResource MetricCard}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Name="valHouseholds" Text="0" Style="{StaticResource MetricValue}" />
                <TextBlock Text="Households" Style="{StaticResource MetricLabel}" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#33F59E0B">
                <fa:IconBlock Icon="Home" FontSize="13" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Border Style="{StaticResource MetricCard}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Name="valPuroks" Text="0" Style="{StaticResource MetricValue}" />
                <TextBlock Text="Active Puroks" Style="{StaticResource MetricLabel}" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#338B5CF6">
                <fa:IconBlock Icon="MapMarkerAlt" FontSize="13" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Border Style="{StaticResource MetricCard}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Name="valMale" Text="0" Style="{StaticResource MetricValue}" Foreground="#60A5FA" />
                <TextBlock Text="Male" Style="{StaticResource MetricLabel}" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#333B82F6">
                <fa:IconBlock Icon="Male" FontSize="13" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Border Style="{StaticResource MetricCard}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Name="valFemale" Text="0" Style="{StaticResource MetricValue}" Foreground="#F472B6" />
                <TextBlock Text="Female" Style="{StaticResource MetricLabel}" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#33EC4899">
                <fa:IconBlock Icon="Female" FontSize="13" Foreground="#F9A8D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Border Style="{StaticResource MetricCard}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Name="valDeceased" Text="0" Style="{StaticResource MetricValue}" Foreground="#94A3B8" />
                <TextBlock Text="Deceased" Style="{StaticResource MetricLabel}" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#3364748B">
                <fa:IconBlock Icon="UserSlash" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
        </WrapPanel>

        <!-- CLASSIFICATIONS -->
      </StackPanel>
      <StackPanel Grid.Row="1">
        <TextBlock Text="Classifications" Style="{StaticResource SectionLabel}" />
        <WrapPanel>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valSeniors" Text="0" Style="{StaticResource MetricValue}" Foreground="#FBBF24" /><TextBlock Text="Seniors" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#33F59E0B"><fa:IconBlock Icon="UserClock" FontSize="12" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valYouth" Text="0" Style="{StaticResource MetricValue}" Foreground="#A78BFA" /><TextBlock Text="Youth" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#338B5CF6"><fa:IconBlock Icon="Child" FontSize="12" Foreground="#C4B5FD" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valPwd" Text="0" Style="{StaticResource MetricValue}" Foreground="#34D399" /><TextBlock Text="PWD" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#3310B981"><fa:IconBlock Icon="Wheelchair" FontSize="12" Foreground="#6EE7B7" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valSoloParents" Text="0" Style="{StaticResource MetricValue}" Foreground="#F472B6" /><TextBlock Text="Solo Parents" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#33EC4899"><fa:IconBlock Icon="UserFriends" FontSize="11" Foreground="#F9A8D4" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valIndigent" Text="0" Style="{StaticResource MetricValue}" Foreground="#F87171" /><TextBlock Text="Indigent" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#33EF4444"><fa:IconBlock Icon="HandHoldingHeart" FontSize="11" Foreground="#FCA5A5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="val4Ps" Text="0" Style="{StaticResource MetricValue}" Foreground="#38BDF8" /><TextBlock Text="4Ps Beneficiaries" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#330EA5E9"><fa:IconBlock Icon="Hands" FontSize="11" Foreground="#7DD3FC" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valVoters" Text="0" Style="{StaticResource MetricValue}" Foreground="#2DD4BF" /><TextBlock Text="Registered Voters" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#3314B8A6"><fa:IconBlock Icon="ThumbsUp" FontSize="11" Foreground="#5EEAD4" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
        </WrapPanel>

        <!-- OPERATIONS -->
      </StackPanel>
      <StackPanel Grid.Row="2">
        <TextBlock Text="Operations" Style="{StaticResource SectionLabel}" />
        <WrapPanel>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valPendingCerts" Text="0" Style="{StaticResource MetricValue}" Foreground="#FBBF24" /><TextBlock Text="Pending Certificates" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#33F59E0B"><fa:IconBlock Icon="ClipboardList" FontSize="12" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valReleasedCerts" Text="0" Style="{StaticResource MetricValue}" Foreground="#34D399" /><TextBlock Text="Released This Month" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#3310B981"><fa:IconBlock Icon="FileAlt" FontSize="12" Foreground="#6EE7B7" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valOpenBlotter" Text="0" Style="{StaticResource MetricValue}" Foreground="#F87171" /><TextBlock Text="Open Blotter" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#33EF4444"><fa:IconBlock Icon="Gavel" FontSize="12" Foreground="#FCA5A5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valResolvedBlotter" Text="0" Style="{StaticResource MetricValue}" Foreground="#34D399" /><TextBlock Text="Resolved Cases" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#3310B981"><fa:IconBlock Icon="Check" FontSize="12" Foreground="#6EE7B7" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valMeetings" Text="0" Style="{StaticResource MetricValue}" Foreground="#818CF8" /><TextBlock Text="Upcoming Meetings" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#336366F1"><fa:IconBlock Icon="CalendarAlt" FontSize="12" Foreground="#A5B4FC" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valBookings" Text="0" Style="{StaticResource MetricValue}" Foreground="#34D399" /><TextBlock Text="Pending Bookings" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#3310B981"><fa:IconBlock Icon="Building" FontSize="12" Foreground="#6EE7B7" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valShiftsToday" Text="0" Style="{StaticResource MetricValue}" Foreground="#FB923C" /><TextBlock Text="Shifts Today" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#33F97316"><fa:IconBlock Icon="ShieldAlt" FontSize="12" Foreground="#FDBA74" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valPatrolLogs" Text="0" Style="{StaticResource MetricValue}" Foreground="#FB923C" /><TextBlock Text="Patrol Logs (7d)" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#33F97316"><fa:IconBlock Icon="Eye" FontSize="12" Foreground="#FDBA74" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valRevenue" Text="₱0.00" Style="{StaticResource MetricValue}" Foreground="#34D399" /><TextBlock Text="Revenue (Month)" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#3310B981"><fa:IconBlock Icon="Coins" FontSize="12" Foreground="#6EE7B7" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
          <Border Style="{StaticResource MetricCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="valAyuda" Text="0" Style="{StaticResource MetricValue}" Foreground="#A78BFA" /><TextBlock Text="Ayuda Released (Month)" Style="{StaticResource MetricLabel}" /></StackPanel><Border Grid.Column="1" Style="{StaticResource IconBubble}" Background="#338B5CF6"><fa:IconBlock Icon="Gift" FontSize="12" Foreground="#C4B5FD" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></Border>
        </WrapPanel>

        <!-- CHARTS -->
      </StackPanel>
      <Grid Grid.Row="3" Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChartCard}">
            <StackPanel>
              <TextBlock Text="Residents by Purok" Style="{StaticResource ChartTitle}" />
              <ItemsControl Name="chartPurok" ItemTemplate="{StaticResource BarRowTemplate}" />
              <TextBlock Name="emptyPurok" Text="No Data Yet" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,16,0,8" />
            </StackPanel>
          </Border>

          <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ChartCard}">
            <StackPanel>
              <TextBlock Text="Residents by Age Bracket" Style="{StaticResource ChartTitle}" />
              <ItemsControl Name="chartAge" ItemTemplate="{StaticResource BarRowTemplate}" />
              <TextBlock Name="emptyAge" Text="No Data Yet" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,16,0,8" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartCard}">
            <StackPanel>
              <TextBlock Text="Blotter by Incident Type" Style="{StaticResource ChartTitle}" />
              <ItemsControl Name="chartBlotter" ItemTemplate="{StaticResource BarRowTemplate}" />
              <TextBlock Name="emptyBlotter" Text="No Data Yet" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,16,0,8" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ChartCard}">
            <StackPanel>
              <TextBlock Text="Certificates Requested by Type" Style="{StaticResource ChartTitle}" />
              <ItemsControl Name="chartCerts" ItemTemplate="{StaticResource BarRowTemplate}" />
              <TextBlock Name="emptyCerts" Text="No Data Yet" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,16,0,8" />
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ChartCard}">
            <StackPanel>
              <TextBlock Text="Bookings by Facility" Style="{StaticResource ChartTitle}" />
              <ItemsControl Name="chartBookings" ItemTemplate="{StaticResource BarRowTemplate}" />
              <TextBlock Name="emptyBookings" Text="No Data Yet" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,16,0,8" />
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ChartCard}">
            <StackPanel>
              <TextBlock Text="Patrol Logs by Severity" Style="{StaticResource ChartTitle}" />
              <ItemsControl Name="chartSeverity" ItemTemplate="{StaticResource BarRowTemplate}" />
              <TextBlock Name="emptySeverity" Text="No Data Yet" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,8,0,4" />
            </StackPanel>
          </Border>

      </Grid>
      <!-- Hidden: Certificate Trend (accessible but not visible to save space) -->
      <ItemsControl Name="chartTrend" Visibility="Collapsed" />
      <TextBlock Name="emptyTrend" Visibility="Collapsed" />
    </Grid>
  </Grid>
</UserControl>
