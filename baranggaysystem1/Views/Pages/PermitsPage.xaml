<UserControl x:Class="baranggaysystem1.Views.Pages.PermitsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="Transparent">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <StackPanel>
          <TextBlock Text="Business Permits" Style="{StaticResource HeadingTextStyle}" />
          <TextBlock Name="recordCountLabel" Text="Review and release permit requests step by step" Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0" />
        </StackPanel>
        <Button HorizontalAlignment="Right" Content="+ New Permit" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAdd_Click" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox Name="searchBox" Height="36" Padding="10,0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Search permit, resident, or business" />
        <Button Grid.Column="2" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Click="BtnRefresh_Click" />
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource ThemeCardBrush}" Margin="20,14,20,16" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" ClipToBounds="True">
      <Grid>
        <!-- Hidden elements preserved for code-behind compatibility -->
        <StackPanel Visibility="Collapsed">
          <Border Name="contextActionBar">
            <StackPanel>
              <TextBlock Name="selectedRecordLabel" />
              <Button Name="btnAdvance" Click="BtnAdvance_Click">
                <TextBlock Name="actionLabel" />
              </Button>
              <Button Name="btnCancel" Click="BtnCancel_Click" />
            </StackPanel>
          </Border>
          <TextBlock Name="footerCountLabel" />
        </StackPanel>
        <DataGrid Name="mainGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource StyledDataGridRowStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="MainGrid_SelectionChanged" MouseDoubleClick="MainGrid_DoubleClick">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Process / Advance Request" Click="BtnAdvance_Click">
                <MenuItem.Icon>
                  <fa:IconBlock Icon="ArrowRight" FontSize="12" Foreground="#10B981" />
                </MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="Cancel Permit Request" Click="BtnCancel_Click">
                <MenuItem.Icon>
                  <fa:IconBlock Icon="TimesCircle" FontSize="12" Foreground="#EF4444" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Request" Binding="{Binding tracking_code}" Width="145" />
            <DataGridTextColumn Header="Resident" Binding="{Binding resident_name}" Width="*" />
            <DataGridTextColumn Header="Permit Type" Binding="{Binding certification_type}" Width="220" />
            <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="140" />
            <DataGridTextColumn Header="Requested" Binding="{Binding requested_on}" Width="170" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <fa:IconBlock Icon="ShieldAlt" FontSize="42" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
          <TextBlock Name="emptyLabel" Text="No permit requests found." Style="{StaticResource SubtitleTextStyle}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
