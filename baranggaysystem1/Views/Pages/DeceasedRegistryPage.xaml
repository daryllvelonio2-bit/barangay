<UserControl x:Class="baranggaysystem1.Views.Pages.DeceasedRegistryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="Transparent">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="36" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <StackPanel>
          <TextBlock Text="Deceased Resident Registry" Style="{StaticResource HeadingTextStyle}" />
          <TextBlock Name="recordCountLabel" Text="Verified records and controlled corrections" Style="{StaticResource SubtitleTextStyle}" />
        </StackPanel>
        <Button HorizontalAlignment="Right" Content="+ Record Death" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAdd_Click" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox Name="searchBox" Height="36" Padding="10,0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Search resident, reference, or verifier" />
        <Button Grid.Column="2" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Click="BtnRefresh_Click" />
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource ThemeCardBrush}" Margin="20,14,20,0" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" ClipToBounds="True">
      <Grid>
        <DataGrid Name="mainGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource StyledDataGridRowStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="MainGrid_SelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Resident" Binding="{Binding resident_name}" Width="*" />
            <DataGridTextColumn Header="Date of Death" Binding="{Binding date_of_death}" Width="145" />
            <DataGridTextColumn Header="Certificate / Reference" Binding="{Binding certificate_reference}" Width="210" />
            <DataGridTextColumn Header="Verified By" Binding="{Binding reported_by}" Width="180" />
            <DataGridTextColumn Header="Status" Binding="{Binding record_status}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <fa:IconBlock Icon="BookMedical" FontSize="44" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
          <TextBlock Name="emptyLabel" Text="No deceased registry records found." Style="{StaticResource SubtitleTextStyle}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Name="contextActionBar" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource ThemeCardHoverBrush}" Margin="20,10,20,0" Padding="14,9" CornerRadius="8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <TextBlock Name="selectedRecordLabel" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0" />
        <Button Name="btnCorrect" Content="Correct / Reverse Record" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCorrect_Click" />
      </StackPanel>
    </Border>
    <Border Grid.Row="4" Margin="20,6,20,10"><TextBlock Name="footerCountLabel" Style="{StaticResource SmallTextStyle}" VerticalAlignment="Center" /></Border>
  </Grid>
</UserControl>
