<UserControl x:Class="baranggaysystem1.Views.Pages.FacilityBookingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             Background="Transparent">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="44" Height="44" CornerRadius="10" Background="#3310B981" Margin="0,0,14,0">
            <fa:IconBlock Icon="Building" Foreground="#34D399" FontSize="20"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Facility Booking" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Name="recordCountLabel" Text="Manage reservations for halls, courts, and equipment."
                       Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="+ New Booking" Style="{StaticResource PrimaryButtonStyle}"
                  MinWidth="150" Click="BtnNewBooking_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource ThemeCardBrush}" Padding="20,0"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <RadioButton Name="tabBookings" Content="Bookings" GroupName="FacilityTabs"
                     IsChecked="True" Checked="Tab_Checked"
                     Padding="16,12" FontWeight="SemiBold" FontSize="13" />
        <RadioButton Name="tabFacilities" Content="Facilities" GroupName="FacilityTabs"
                     Checked="Tab_Checked"
                     Padding="16,12" FontWeight="SemiBold" FontSize="13" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource ToolbarBorderStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource ThemeCardBrush}" CornerRadius="6"
                BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1" Height="36">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="13"
                          Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox Name="searchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                     VerticalContentAlignment="Center" FontSize="13" Margin="0,0,8,0"
                     TextChanged="SearchBox_TextChanged" />
          </Grid>
        </Border>
        <ComboBox Name="statusFilter" Grid.Column="1" Width="170" Height="36" Margin="10,0,0,0"
                  Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" />
        <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Height="36"
                MinWidth="0" Padding="12,0" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource ThemeCardBrush}" Margin="20,14,20,16" CornerRadius="8"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" ClipToBounds="True">
      <Grid>
        <!-- Hidden elements preserved for code-behind compatibility -->
        <StackPanel Visibility="Collapsed">
          <Border Name="contextActionBar">
            <StackPanel>
              <TextBlock Name="selectedLabel" />
              <Button Name="btnEdit" Click="BtnEdit_Click" />
              <Button Name="btnApprove" Click="BtnApprove_Click" />
              <Button Name="btnReject" Click="BtnReject_Click" />
              <Button Name="btnCancel" Click="BtnCancelBooking_Click" />
              <Button Name="btnComplete" Click="BtnComplete_Click" />
            </StackPanel>
          </Border>
        </StackPanel>
        <DataGrid Name="mainGrid" Style="{StaticResource StyledDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}"
                  RowStyle="{StaticResource StyledDataGridRowStyle}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionChanged="MainGrid_SelectionChanged"
                  MouseDoubleClick="MainGrid_DoubleClick">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Edit Booking" Click="BtnEdit_Click">
                <MenuItem.Icon>
                  <fa:IconBlock Icon="Edit" FontSize="12" Foreground="{DynamicResource AccentBlueBrush}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Approve Booking" Click="BtnApprove_Click">
                <MenuItem.Icon>
                  <fa:IconBlock Icon="CheckCircle" FontSize="12" Foreground="#10B981" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Reject Booking" Click="BtnReject_Click">
                <MenuItem.Icon>
                  <fa:IconBlock Icon="TimesCircle" FontSize="12" Foreground="#EF4444" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Complete Booking" Click="BtnComplete_Click">
                <MenuItem.Icon>
                  <fa:IconBlock Icon="CheckDouble" FontSize="12" Foreground="#06B6D4" />
                </MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="Cancel Booking" Click="BtnCancelBooking_Click">
                <MenuItem.Icon>
                  <fa:IconBlock Icon="Ban" FontSize="12" Foreground="#F59E0B" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>
        <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed">
          <fa:IconBlock Icon="Building" FontSize="48" Foreground="{DynamicResource ThemeTextMutedBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,12" />
          <TextBlock Name="emptyLabel" Text="No records found."
                     Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</UserControl>
