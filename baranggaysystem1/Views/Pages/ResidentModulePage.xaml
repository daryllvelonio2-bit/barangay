<UserControl x:Class="baranggaysystem1.Views.Pages.ResidentModulePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Background="Transparent" xmlns:pages="clr-namespace:baranggaysystem1.Views.Pages;assembly=baranggaysystem1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ResidentStatCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="Border.Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinWidth" Value="118" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.10" Direction="270" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ResidentStatLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
      <Style x:Key="ResidentStatValueStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HeadingTextStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
      </Style>
      <Style x:Key="ResidentSurfaceCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="16" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.15" Direction="270" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ResidentSearchShellStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeInputBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="10" />
        <Setter Property="Height" Value="34" />
      </Style>
      <Style x:Key="ResidentMetaBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
      </Style>
      <Style x:Key="ResidentDataGridRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource StyledDataGridRowStyle}">
        <Setter Property="Background" Value="{DynamicResource ThemeGridRowBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
          <Trigger Property="DataGridRow.AlternationIndex" Value="1">
            <Setter Property="Background" Value="{DynamicResource ThemeGridRowAltBgBrush}" />
          </Trigger>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource ThemeGridRowHoverBrush}" />
          </Trigger>
          <Trigger Property="DataGridRow.IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource ThemeGridRowSelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeGridRowSelectedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ResidentDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeGridBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="ResidentIdBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="8,2" />
      </Style>
      <Style x:Key="ResidentStatusBadgeBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#3322C55E" />
        <Setter Property="BorderBrush" Value="#6622C55E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="10,4" />
        <Style.Triggers>
          <Trigger Property="FrameworkElement.Tag" Value="Active">
            <Setter Property="Background" Value="#3322C55E" />
            <Setter Property="BorderBrush" Value="#6622C55E" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="ACTIVE">
            <Setter Property="Background" Value="#3322C55E" />
            <Setter Property="BorderBrush" Value="#6622C55E" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="Inactive">
            <Setter Property="Background" Value="#3364748B" />
            <Setter Property="BorderBrush" Value="#6664748B" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="INACTIVE">
            <Setter Property="Background" Value="#3364748B" />
            <Setter Property="BorderBrush" Value="#6664748B" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="Deceased">
            <Setter Property="Background" Value="#33EF4444" />
            <Setter Property="BorderBrush" Value="#66EF4444" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="DECEASED">
            <Setter Property="Background" Value="#33EF4444" />
            <Setter Property="BorderBrush" Value="#66EF4444" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ResidentStatusBadgeTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="Foreground" Value="#34D399" />
        <Setter Property="FontWeight" Value="Bold" />
        <Style.Triggers>
          <Trigger Property="FrameworkElement.Tag" Value="Active">
            <Setter Property="Foreground" Value="#34D399" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="ACTIVE">
            <Setter Property="Foreground" Value="#34D399" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="Inactive">
            <Setter Property="Foreground" Value="#94A3B8" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="INACTIVE">
            <Setter Property="Foreground" Value="#94A3B8" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="Deceased">
            <Setter Property="Foreground" Value="#F87171" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="DECEASED">
            <Setter Property="Foreground" Value="#F87171" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource PageHeaderStyle}" Padding="22,8,22,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="34" Height="34" CornerRadius="10" Background="#3322C55E" Margin="0,0,12,0">
            <fa:IconBlock Icon="Users" Foreground="#34D399" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Name="pageTitleText" Text="Resident Records" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontFamily="{StaticResource SegoeUi}" />
              <!-- Registry filter tabs inline -->
              <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <RadioButton Name="filterAll" Content="All" GroupName="RegistryFilter" IsChecked="True" Style="{StaticResource RibbonRadioTabStyle}" Checked="RegistryFilter_Changed" />
                <RadioButton Name="filterSoloParent" Content="Solo Parent" GroupName="RegistryFilter" Style="{StaticResource RibbonRadioTabStyle}" Checked="RegistryFilter_Changed" />
                <RadioButton Name="filterYouth" Content="Youth" GroupName="RegistryFilter" Style="{StaticResource RibbonRadioTabStyle}" Checked="RegistryFilter_Changed" />
                <RadioButton Name="filterIndigent" Content="Indigent" GroupName="RegistryFilter" Style="{StaticResource RibbonRadioTabStyle}" Checked="RegistryFilter_Changed" />
              </StackPanel>
            </StackPanel>
            <TextBlock Name="recordCountLabel" Text="Loading records..." Style="{StaticResource SubtitleTextStyle}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,1,0,0" FontWeight="SemiBold" />
            <WrapPanel Margin="0,4,0,0" VerticalAlignment="Center">
              <TextBlock Name="totalResidentsMetric" Text="0 residents" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              <TextBlock Text="•" Margin="6,0" FontSize="10" Foreground="{DynamicResource ThemeTextMutedBrush}" />
              <TextBlock Name="activeResidentsMetric" Text="0 active" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              <TextBlock Text="•" Margin="6,0" FontSize="10" Foreground="{DynamicResource ThemeTextMutedBrush}" />
              <TextBlock Name="purokResidentsMetric" Text="0 puroks" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              <TextBlock Text="•" Margin="6,0" FontSize="10" Foreground="{DynamicResource ThemeTextMutedBrush}" />
              <TextBlock Name="visibleResidentsMetric" Text="0 visible" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" MinWidth="88" Height="32" Padding="10,0">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Download" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Export" VerticalAlignment="Center" FontSize="11" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="118" Height="32" Padding="10,0" Click="BtnAdd_Click">
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="UserPlus" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Add Resident" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="11" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource ToolbarBorderStyle}" Padding="22,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource ResidentSearchShellStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <fa:IconBlock Grid.Column="0" Icon="Search" FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Grid Column="1">
              <TextBox Name="searchBox" Margin="0,0,12,0" Background="Transparent" Foreground="{DynamicResource ThemeInputTextBrush}" CaretBrush="{DynamicResource ThemeInputTextBrush}" BorderThickness="0" VerticalContentAlignment="Center" FontSize="11" TextChanged="SearchBox_TextChanged" />
              <TextBlock Name="searchPlaceholderText" Text="Search by resident name, contact, purok, or ID" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeInputPlaceholderBrush}" IsHitTestVisible="False">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="" Binding="{Binding Text, ElementName=searchBox}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </Grid>
          </Grid>
        </Border>
        <ComboBox Name="filterStatus" Grid.Column="1" Width="122" Height="32" Margin="8,0,0,0" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" />
        <ComboBox Name="filterPurok" Grid.Column="2" Width="130" Height="32" Margin="8,0,0,0" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="Filter_SelectionChanged" />
        <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" Height="32" MinWidth="0" Padding="10,0" Click="BtnRefresh_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="SyncAlt" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Refresh" VerticalAlignment="Center" FontSize="11" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="2" Margin="20,8,20,16" ClipToBounds="True" Style="{StaticResource ResidentSurfaceCardStyle}">
      <!-- Hidden elements referenced by code-behind -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Visibility="Collapsed">
          <TextBlock Name="tableTitleText" />
          <TextBlock Name="tableMetaLabel" />
          <TextBlock Name="tableVisibleLabel" />
          <TextBlock Name="tableSelectionLabel" />
          <TextBlock Name="footerCountLabel" />
          <Border Name="contextActionBar">
            <StackPanel>
              <TextBlock Name="selectedResidentLabel" />
              <TextBlock Name="selectedResidentMetaLabel" />
              <Button Name="btnContextBlotter" Click="BtnContextBlotter_Click" />
              <Button Name="btnContextBlotterHistory" Click="BtnContextBlotterHistory_Click" />
              <Button Name="btnContextCert" Click="BtnContextCert_Click" />
              <Button Name="btnContextHousehold" Click="BtnContextHousehold_Click" />
              <Button Name="btnContextPayment" Click="BtnContextPayment_Click" />
            </StackPanel>
          </Border>
          <Button Name="btnEdit" Click="BtnEdit_Click" />
          <Button Name="btnDelete" Click="BtnDelete_Click" />
        </StackPanel>
        <Grid Row="0">
          <DataGrid Name="mainGrid" Margin="6,4,6,6" Background="Transparent" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource ResidentDataGridRowStyle}" CellStyle="{StaticResource ResidentDataGridCellStyle}" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2" RowHeight="42" HeadersVisibility="Column" CanUserAddRows="False" SelectionChanged="MainGrid_SelectionChanged" MouseDoubleClick="MainGrid_DoubleClick">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Edit Resident" Click="BtnEdit_Click">
                  <MenuItem.Icon><fa:IconBlock Icon="Edit" FontSize="12" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="File Blotter" Click="BtnContextBlotter_Click">
                  <MenuItem.Icon><fa:IconBlock Icon="Gavel" FontSize="12" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Blotter History" Click="BtnContextBlotterHistory_Click">
                  <MenuItem.Icon><fa:IconBlock Icon="History" FontSize="12" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Issue Certificate" Click="BtnContextCert_Click">
                  <MenuItem.Icon><fa:IconBlock Icon="FileContract" FontSize="12" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open Household" Click="BtnContextHousehold_Click">
                  <MenuItem.Icon><fa:IconBlock Icon="Home" FontSize="12" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Record Payment" Click="BtnContextPayment_Click">
                  <MenuItem.Icon><fa:IconBlock Icon="MoneyBillWave" FontSize="12" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Archive Resident" Click="BtnDelete_Click" Foreground="#F87171">
                  <MenuItem.Icon><fa:IconBlock Icon="Trash" FontSize="12" Foreground="#F87171" /></MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Resident" Width="2.4*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding full_name}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Age" Width="0.55*" ElementStyle="{StaticResource BodyTextStyle}" Binding="{Binding age_display}" />
              <DataGridTextColumn Header="Sex" Width="0.75*" ElementStyle="{StaticResource BodyTextStyle}" Binding="{Binding sex_display}" />
              <DataGridTextColumn Header="Purok" Width="1.1*" ElementStyle="{StaticResource BodyTextStyle}" Binding="{Binding purok_display}" />
              <DataGridTextColumn Header="Contact" Width="1.15*" ElementStyle="{StaticResource BodyTextStyle}" Binding="{Binding contact_display, TargetNullValue=No contact}" />
              <DataGridTemplateColumn Header="Status" Width="0.9*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ResidentStatusBadgeBorderStyle}" HorizontalAlignment="Left" Tag="{Binding status_display}">
                      <TextBlock Style="{StaticResource ResidentStatusBadgeTextStyle}" Text="{Binding status_display}" Tag="{Binding status_display}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <fa:IconBlock Icon="UserSlash" FontSize="48" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Name="emptyLabel" Text="No residents found." Style="{StaticResource SubtitleTextStyle}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Try adjusting your search or filters." FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

  </Grid>
</UserControl>
