<Window x:Class="baranggaysystem1.Views.NotificationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification Settings"
        WindowStartupLocation="CenterOwner"
        Width="600"
        Height="700"
        ResizeMode="CanResize"
        Style="{StaticResource BaseWindowStyle}"
        Background="{DynamicResource ThemeBgBrush}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
            <StackPanel>
                <!-- Header -->
                <TextBlock Text="Notification Settings"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           Margin="0,0,0,8" />
                <TextBlock Text="Configure email and SMS notifications for the system."
                           FontSize="13"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                           Margin="0,0,0,24" />

                <!-- SMTP Section -->
                <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📧 Email (SMTP)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                            <CheckBox x:Name="smtpEnabledCheck" Content="Enabled" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="SMTP Host" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2" />
                                <TextBox x:Name="smtpHostBox" Style="{StaticResource StyledTextBoxStyle}" FontSize="13" Padding="8,6" Margin="0,0,0,8" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Port" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2" />
                                <TextBox x:Name="smtpPortBox" Style="{StaticResource StyledTextBoxStyle}" FontSize="13" Padding="8,6" Margin="0,0,0,8" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="From Email" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox x:Name="smtpFromBox" Style="{StaticResource StyledTextBoxStyle}" FontSize="13" Padding="8,6" Margin="0,0,0,8" />

                        <TextBlock Text="From Name" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox x:Name="smtpFromNameBox" Style="{StaticResource StyledTextBoxStyle}" FontSize="13" Padding="8,6" Margin="0,0,0,8" />

                        <TextBlock Text="Username" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox x:Name="smtpUserBox" Style="{StaticResource StyledTextBoxStyle}" FontSize="13" Padding="8,6" Margin="0,0,0,8" />

                        <TextBlock Text="Password" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2" />
                        <PasswordBox x:Name="smtpPassBox" Style="{StaticResource StyledPasswordBoxStyle}" FontSize="13" Padding="8,6" Margin="0,0,0,8" />

                        <CheckBox x:Name="smtpSslCheck" Content="Use SSL/TLS" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,4,0,12" IsChecked="True" />

                        <!-- Test button -->
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="smtpTestEmailBox" Style="{StaticResource StyledTextBoxStyle}" Width="200" FontSize="12" Padding="6,4" />
                            <Button Content="Send Test" Click="TestSmtp_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" FontSize="12" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SMS Section -->
                <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📱 SMS" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                            <CheckBox x:Name="smsEnabledCheck" Content="Enabled" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="API URL" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox x:Name="smsApiUrlBox" Style="{StaticResource StyledTextBoxStyle}" FontSize="13" Padding="8,6" Margin="0,0,0,8" />

                        <TextBlock Text="API Token (Bearer)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2" />
                        <PasswordBox x:Name="smsTokenBox" Style="{StaticResource StyledPasswordBoxStyle}" FontSize="13" Padding="8,6" Margin="0,0,0,8" />

                        <TextBlock Text="Sender Name" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBox x:Name="smsSenderBox" Style="{StaticResource StyledTextBoxStyle}" FontSize="13" Padding="8,6" Margin="0,0,0,8" />

                        <!-- Test button -->
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="smsTestNumberBox" Style="{StaticResource StyledTextBoxStyle}" Width="200" FontSize="12" Padding="6,4" />
                            <Button Content="Send Test" Click="TestSms_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" FontSize="12" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Reminder Automation Section -->
                <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="⏰ Automated Reminders" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,12" />

                        <CheckBox x:Name="renewalReminderCheck" Content="Certificate Renewal Reminders" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,12">
                            <TextBlock Text="Remind" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBox x:Name="renewalDaysBox" Style="{StaticResource StyledTextBoxStyle}" Width="50" FontSize="12" Padding="4" Margin="8,0,8,0" TextAlignment="Center" />
                            <TextBlock Text="days before expiry" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox x:Name="blotterReminderCheck" Content="Blotter Case Follow-up Reminders" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                            <TextBlock Text="Remind after" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBox x:Name="blotterAgeDaysBox" Style="{StaticResource StyledTextBoxStyle}" Width="50" FontSize="12" Padding="4" Margin="8,0,8,0" TextAlignment="Center" />
                            <TextBlock Text="days of inactivity" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Status message -->
                <TextBlock x:Name="statusLabel"
                           Text=""
                           FontSize="12"
                           Foreground="#4CAF50"
                           Margin="0,0,0,12"
                           Visibility="Collapsed" />

                <!-- Save/Cancel -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Save Settings"
                            Click="SaveButton_Click"
                            Padding="20,10"
                            FontSize="14"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0" />
                    <Button Content="Close"
                            Click="CloseButton_Click"
                            Padding="20,10"
                            FontSize="14"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
