<nav:FullscreenFormBase x:Class="baranggaysystem1.Views.Panels.CertificateFormPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:controls="clr-namespace:baranggaysystem1.Views.Controls"
             xmlns:nav="clr-namespace:baranggaysystem1.ViewModels.Navigation">

    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Validation Panel -->
        <controls:FormValidationPanel x:Name="validationPanel" Grid.Row="0" Margin="0,0,0,6" Visibility="Collapsed" />

        <!-- Resident Selection -->
        <StackPanel x:Name="residentPickerSection" Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Resident *" Style="{StaticResource LabelTextStyle}" />
            <ComboBox x:Name="cmbResident" Style="{StaticResource StyledComboBoxStyle}"
                      DisplayMemberPath="DisplayName"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="FullName"
                      SelectionChanged="ComboField_Changed" />
        </StackPanel>

        <!-- Pre-selected Resident Display -->
        <Border x:Name="residentDisplaySection" Grid.Row="1" Visibility="Collapsed"
                Background="#3364748B" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="User" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="txtResidentDisplay" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Document Type + Purpose -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Document Type *" Style="{StaticResource LabelTextStyle}" />
                <ComboBox x:Name="cmbDocumentType" Style="{StaticResource StyledComboBoxStyle}"
                          DisplayMemberPath="Name"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Name"
                          SelectionChanged="DocumentType_Changed" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Purpose *" Style="{StaticResource LabelTextStyle}" />
                <TextBox x:Name="txtPurpose" Style="{StaticResource StyledTextBoxStyle}"
                         TextChanged="Field_Changed" LostFocus="Field_LostFocus" />
            </StackPanel>
        </Grid>

        <!-- Business Fields (conditional) -->
        <StackPanel x:Name="businessFieldsSection" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Business Name *" Style="{StaticResource LabelTextStyle}" />
                    <TextBox x:Name="txtBusinessName" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" LostFocus="Field_LostFocus" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Business Nature *" Style="{StaticResource LabelTextStyle}" />
                    <TextBox x:Name="txtBusinessNature" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" LostFocus="Field_LostFocus" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Payment Section (shown for Issue mode) -->
        <StackPanel x:Name="paymentSection" Grid.Row="4" Visibility="Collapsed" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Fee (PHP)" Style="{StaticResource LabelTextStyle}" />
                    <TextBox x:Name="txtFee" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="OR Number" Style="{StaticResource LabelTextStyle}" />
                    <TextBox x:Name="txtOrNumber" Style="{StaticResource StyledTextBoxStyle}" TextChanged="Field_Changed" LostFocus="Field_LostFocus" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Payment Method" Style="{StaticResource LabelTextStyle}" />
                    <ComboBox x:Name="cmbPaymentMethod" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="ComboField_Changed" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Issued Date" Style="{StaticResource LabelTextStyle}" />
                    <DatePicker x:Name="dpIssuedDate" Padding="2" Height="30" SelectedDateChanged="DateField_Changed" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Helper Text -->
        <TextBlock x:Name="txtHelperText" Grid.Row="5" FontSize="10" Foreground="{DynamicResource ThemeTextMutedBrush}" TextWrapping="Wrap" />
    </Grid>
</nav:FullscreenFormBase>
