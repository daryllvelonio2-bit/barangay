<Window x:Class="baranggaysystem1.Views.Dialogs.PaymentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Record Collection &amp; Payment" Width="550" Height="620" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{DynamicResource ThemeCardHoverBrush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- Green header removed for fullscreen view -->
    <StackPanel Grid.Row="0" Visibility="Collapsed">
      <TextBlock Text="NEW COLLECTION RECORD" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
      <StackPanel>
        <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16" Visibility="{Binding ShowResidentPicker, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="Resident" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox DisplayMemberPath="DisplayName" Style="{StaticResource StyledComboBoxStyle}" Height="40" ItemsSource="{Binding ResidentOptions}" SelectedItem="{Binding SelectedResident}" />
          </StackPanel>
        </Border>
        <TextBlock Text="Reference O.R. Number" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
        <TextBox IsReadOnly="True" Style="{StaticResource StyledTextBoxStyle}" Height="40" Background="#3364748B" FontWeight="Bold" Margin="0,0,0,20" Text="{Binding OrNumber}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Collection Amount (PHP)" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="40" FontSize="18" FontWeight="Bold" Foreground="#34D399" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Payment Method" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,8" />
            <ComboBox Style="{StaticResource StyledComboBoxStyle}" Height="40" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Transaction Remarks" Style="{StaticResource LabelTextStyle}" Margin="0,20,0,8" />
        <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40" Margin="0,0,12,0" IsCancel="True" />
          <Button Content="Confirm Payment" Style="{StaticResource PrimaryButtonStyle}" Background="#166534" BorderBrush="#166534" Width="180" Height="40" Command="{Binding SavePaymentCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel VerticalAlignment="Center">
        <fa:IconBlock Icon="Spinner" FontSize="40" Foreground="#34D399" HorizontalAlignment="Center">
          <UIElement.RenderTransform>
            <RotateTransform CenterX="20" CenterY="20" />
          </UIElement.RenderTransform>
          <FrameworkElement.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </FrameworkElement.Triggers>
        </fa:IconBlock>
        <TextBlock Text="Processing transaction..." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>