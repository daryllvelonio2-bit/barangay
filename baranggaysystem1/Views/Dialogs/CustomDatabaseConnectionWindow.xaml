<Window x:Class="baranggaysystem1.Views.Dialogs.CustomDatabaseConnectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Custom Database Setup" Width="640" Height="620" MinWidth="560" MinHeight="520" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Slate900Brush}" Padding="20,14">
      <StackPanel>
        <TextBlock Text="Custom Database Setup" Foreground="#FFFFFFFF" FontFamily="{StaticResource CenturyGothic}" FontSize="16" FontWeight="Bold" />
        <TextBlock Text="Save your own MySQL root, password, and database name. Optionally attach a ZIP backup to restore after connecting." Foreground="#D6E4F7" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,18">
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Database Host" Style="{StaticResource LabelTextStyle}" />
            <TextBox Name="txtDbHost" Style="{StaticResource StyledTextBoxStyle}" />
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="Port" Style="{StaticResource LabelTextStyle}" />
            <TextBox Name="txtDbPort" Style="{StaticResource StyledTextBoxStyle}" />
          </StackPanel>
        </Grid>

        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="Database Name" Style="{StaticResource LabelTextStyle}" />
          <TextBox Name="txtDbName" Style="{StaticResource StyledTextBoxStyle}" />
        </StackPanel>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Username" Style="{StaticResource LabelTextStyle}" />
            <TextBox Name="txtDbUser" Style="{StaticResource StyledTextBoxStyle}" />
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="Password" Style="{StaticResource LabelTextStyle}" />
            <PasswordBox Name="txtDbPassword" Style="{StaticResource StyledPasswordBoxStyle}" />
          </StackPanel>
        </Grid>

        <CheckBox Name="chkDbUseSsl" Content="Use SSL" Margin="0,2,0,14" />

        <Border Background="{DynamicResource ThemeCardHoverBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Optional Backup ZIP" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,4" />
            <TextBlock Text="Select a ZIP backup created by the system. If provided, it will be restored into the selected database after the profile is saved." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <TextBox Name="txtBackupZipPath" Grid.Column="0" Style="{StaticResource StyledTextBoxStyle}" IsReadOnly="True" />
              <Button Grid.Column="2" Content="Browse ZIP" Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowseBackup_Click" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Margin="0,0,10,0" />
        <Button Name="btnSave" Content="Save &amp; Connect" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="BtnSave_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
