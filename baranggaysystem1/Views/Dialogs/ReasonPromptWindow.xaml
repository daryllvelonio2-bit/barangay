<Window x:Class="baranggaysystem1.Views.Dialogs.ReasonPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" Height="310"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource BaseWindowStyle}"
        Background="{DynamicResource ThemeCardHoverBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Padding="22,18" Background="{DynamicResource ThemeCardBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Name="titleText" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
        <TextBlock Name="promptText" Margin="0,5,0,0" TextWrapping="Wrap"
                   Style="{StaticResource SmallTextStyle}" />
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="1" Margin="22,16">
      <TextBlock Text="Reason" Style="{StaticResource LabelTextStyle}" />
      <TextBox Name="reasonBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalContentAlignment="Top" Padding="9"
               Style="{StaticResource StyledTextBoxStyle}" />
      <TextBlock Name="validationText" Margin="0,7,0,0" Foreground="#FFDC2626"
                 FontWeight="SemiBold" Visibility="Collapsed"
                 Text="Enter a clear reason of at least five characters." />
    </StackPanel>
    <Border Grid.Row="2" Padding="22,12" Background="{DynamicResource ThemeCardBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Width="90" Height="36" Margin="0,0,10,0"
                Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
        <Button Name="confirmButton" Content="Confirm" Width="120" Height="36"
                Style="{StaticResource PrimaryButtonStyle}" IsDefault="True"
                Click="ConfirmButton_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
