<Window x:Class="baranggaysystem1.Views.Dialogs.ProcurementRequestWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Procurement Request" Width="620" Height="720" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,18">
        <TextBlock Text="Request title" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,7" />
        <TextBox Name="titleBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Request date" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,7" /><DatePicker Name="requestDatePicker" Height="38" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Needed by" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,7" /><DatePicker Name="neededByPicker" Height="38" /></StackPanel>
        </Grid>
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Request type" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,7" /><ComboBox Name="typeCombo" IsEditable="True" Style="{StaticResource StyledComboBoxStyle}" Height="40" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Category" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,7" /><TextBox Name="categoryBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" /></StackPanel>
        </Grid>
        <TextBlock Text="Items / scope" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,7" />
        <TextBox Name="itemsBox" Style="{StaticResource StyledTextBoxStyle}" Height="85" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Estimated amount (PHP)" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,7" /><TextBox Name="amountBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Vendor (optional)" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,7" /><TextBox Name="vendorBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" /></StackPanel>
        </Grid>
        <TextBlock Text="Purchase order no. (when available)" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,7" />
        <TextBox Name="poBox" Style="{StaticResource StyledTextBoxStyle}" Height="40" />
        <TextBlock Text="Notes" Style="{StaticResource LabelTextStyle}" Margin="0,16,0,7" />
        <TextBox Name="notesBox" Style="{StaticResource StyledTextBoxStyle}" Height="75" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Margin="0,0,8,0" />
        <Button Name="saveButton" Content="Save Draft" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
