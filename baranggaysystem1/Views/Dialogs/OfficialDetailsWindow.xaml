<Window x:Class="baranggaysystem1.Views.Dialogs.OfficialDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Official Appointment" Width="720" Height="650" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Background="{StaticResource Slate900Brush}" Padding="20,14">
      <StackPanel>
        <TextBlock Name="titleLabel" Text="New Official Appointment" Foreground="White" FontSize="17" FontWeight="Bold" />
        <TextBlock Text="Assign an existing resident to a defined term." Foreground="#FFCBD5E1" Margin="0,3,0,0" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,18">
        <TextBlock Text="Resident" Style="{StaticResource LabelTextStyle}" />
        <ComboBox Name="residentCombo" Height="38" DisplayMemberPath="DisplayName" Style="{StaticResource StyledComboBoxStyle}" Margin="0,0,0,12" />
        <TextBlock Text="Position" Style="{StaticResource LabelTextStyle}" />
        <TextBox Name="positionBox" Height="38" Margin="0,0,0,12" />
        <TextBlock Text="Committee / Assignment" Style="{StaticResource LabelTextStyle}" />
        <TextBox Name="committeeBox" Height="38" Margin="0,0,0,12" />
        <TextBlock Text="Term" Style="{StaticResource LabelTextStyle}" />
        <ComboBox Name="termCombo" Height="38" DisplayMemberPath="DisplayName" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="TermCombo_SelectionChanged" Margin="0,0,0,12" />
        <Border Name="newTermPanel" Visibility="Collapsed" Background="{DynamicResource ThemeCardHoverBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Term start" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Grid.Column="2" Text="Term end" Style="{StaticResource LabelTextStyle}" />
            <DatePicker Name="termStartPicker" Grid.Row="1" Height="36" />
            <DatePicker Name="termEndPicker" Grid.Row="1" Grid.Column="2" Height="36" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Term notes" Style="{StaticResource LabelTextStyle}" Margin="0,10,0,0" />
            <TextBox Name="termNotesBox" Grid.Row="3" Grid.ColumnSpan="3" Height="58" AcceptsReturn="True" TextWrapping="Wrap" />
          </Grid>
        </Border>
        <TextBlock Text="Status" Style="{StaticResource LabelTextStyle}" />
        <ComboBox Name="statusCombo" Height="38" Style="{StaticResource StyledComboBoxStyle}">
          <ComboBoxItem Content="ACTIVE" IsSelected="True" />
          <ComboBoxItem Content="INACTIVE" />
        </ComboBox>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource ThemeCardHoverBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Margin="0,0,8,0" />
        <Button Name="btnConfirm" Content="Save Appointment" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="BtnConfirm_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
