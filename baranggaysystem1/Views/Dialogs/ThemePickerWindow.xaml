<Window x:Class="baranggaysystem1.Views.Dialogs.ThemePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Choose Appearance"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="#0F172A" CornerRadius="24" Padding="0" MinWidth="520">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" Opacity="0.50" ShadowDepth="8" Direction="270" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="48,44,48,36">
            <!-- Header -->
            <TextBlock Text="Choose Your Appearance"
                       Foreground="#FFFFFFFF"
                       FontFamily="Century Gothic"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Select a theme to personalize your workspace"
                       Foreground="#94A3B8"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,32" />

            <!-- Theme options -->
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <!-- Light Mode button -->
                <Button Name="btnLight" Grid.Column="0" Cursor="Hand" Click="BtnLight_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Name="lightCard" Background="#1E293B" CornerRadius="18" Padding="24,28" BorderBrush="#334155" BorderThickness="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="80" Height="80" CornerRadius="20" Background="#F8FAFC" Margin="0,0,0,16" HorizontalAlignment="Center">
                                        <fa:IconBlock Icon="Sun" FontSize="40" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Light Mode" Foreground="#FFFFFFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Clean and bright" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="lightCard" Property="BorderBrush" Value="#60A5FA" />
                                    <Setter TargetName="lightCard" Property="Background" Value="#1E3A5F" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Dark Mode button -->
                <Button Name="btnDark" Grid.Column="2" Cursor="Hand" Click="BtnDark_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Name="darkCard" Background="#1E293B" CornerRadius="18" Padding="24,28" BorderBrush="#334155" BorderThickness="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="80" Height="80" CornerRadius="20" Margin="0,0,0,16" HorizontalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1E3A8A" Offset="0" />
                                                <GradientStop Color="#3B82F6" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <fa:IconBlock Icon="Moon" FontSize="40" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Dark Mode" Foreground="#FFFFFFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Easy on the eyes" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="darkCard" Property="BorderBrush" Value="#60A5FA" />
                                    <Setter TargetName="darkCard" Property="Background" Value="#1E3A5F" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Clarification text -->
            <Border Background="#1E293B" CornerRadius="10" Padding="14,10" Margin="0,28,0,0" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="InfoCircle" FontSize="13" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="You can always change this later using the toggle in the top bar."
                               Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
