<Window x:Class="baranggaysystem1.Views.Dialogs.HouseholdEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Width="760" Height="620" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{DynamicResource ThemeCardHoverBrush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1" Title="{Binding WindowTitle}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="16,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Purok -->
      <StackPanel Grid.Row="0" Margin="0,0,0,8">
        <TextBlock Text="Purok" Style="{StaticResource LabelTextStyle}" />
        <ComboBox DisplayMemberPath="Name" Style="{StaticResource StyledComboBoxStyle}" ItemsSource="{Binding PurokOptions}" SelectedItem="{Binding SelectedPurok}" />
      </StackPanel>

      <!-- House No + Street -->
      <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="House No." Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding HouseNo, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Street" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Text="Subdivision" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Subdivision, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>

      <!-- Landmark -->
      <StackPanel Grid.Row="2" Margin="0,0,0,8">
        <TextBlock Text="Landmark or remarks" Style="{StaticResource LabelTextStyle}" />
        <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="50" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="6" Text="{Binding AddressNote, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>

      <!-- Coordinates -->
      <Grid Grid.Row="3" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Latitude (optional)" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding LatitudeText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Longitude (optional)" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding LongitudeText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="30" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
        <Button Style="{StaticResource PrimaryButtonStyle}" Width="150" Height="30" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
