<Window x:Class="baranggaysystem1.Views.Dialogs.AyudaReleaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Width="920" Height="820"
        MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeCardHoverBrush}"
        Title="{Binding WindowTitle}">
  <Window.Resources>
    <Style x:Key="WorkflowStepBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="SummaryCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource ThemeCardBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1"
            Padding="24,16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding WorkflowTitle}" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Text="{Binding WorkflowDescription}" Margin="0,4,0,0"
                       Style="{StaticResource SmallTextStyle}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding ReferenceNo}" VerticalAlignment="Center"
                     Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontWeight="SemiBold" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource WorkflowStepBorderStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsProgramStep}" Value="True">
                    <Setter Property="Background" Value="#1F2563EB" />
                    <Setter Property="BorderBrush" Value="#FF3B82F6" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Border Width="24" Height="24" CornerRadius="12" Background="#FF2563EB">
                <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="9,0,0,0">
                <TextBlock Text="Program" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                <TextBlock Text="Budget and date" Style="{StaticResource SmallTextStyle}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="1">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource WorkflowStepBorderStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBeneficiaryStep}" Value="True">
                    <Setter Property="Background" Value="#1F2563EB" />
                    <Setter Property="BorderBrush" Value="#FF3B82F6" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Border Width="24" Height="24" CornerRadius="12" Background="#FF2563EB">
                <TextBlock Text="2" Foreground="White" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="9,0,0,0">
                <TextBlock Text="Beneficiaries" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                <TextBlock Text="Verify and stage" Style="{StaticResource SmallTextStyle}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Margin="0">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource WorkflowStepBorderStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsReviewStep}" Value="True">
                    <Setter Property="Background" Value="#1F16A34A" />
                    <Setter Property="BorderBrush" Value="#FF22C55E" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Border Width="24" Height="24" CornerRadius="12" Background="#FF16A34A">
                <TextBlock Text="3" Foreground="White" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="9,0,0,0">
                <TextBlock Text="Review" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                <TextBlock Text="Confirm and post" Style="{StaticResource SmallTextStyle}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Margin="24,14,24,0" Padding="12,9" CornerRadius="8"
              Background="#33DC2626" BorderBrush="#66EF4444" BorderThickness="1"
              Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal">
          <fa:IconBlock Icon="ExclamationTriangle" Foreground="#FFEF4444"
                        FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0" />
          <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                     Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>

      <Grid Grid.Row="1">
        <!-- Step 1: program and release details -->
        <ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsProgramStep, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <Border Style="{StaticResource SummaryCardStyle}">
              <StackPanel>
                <TextBlock Text="Funded assistance program" Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock Text="Only active programs with remaining funds can be selected."
                           Margin="0,4,0,12" Style="{StaticResource SmallTextStyle}" />
                <TextBlock Text="Program" Style="{StaticResource LabelTextStyle}" />
                <ComboBox DisplayMemberPath="DisplayName" Height="42"
                          Style="{StaticResource StyledComboBoxStyle}"
                          ItemsSource="{Binding ProgramOptions}" SelectedItem="{Binding SelectedProgram}" />
                <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="8"
                        Background="#2022C55E" BorderBrush="#6622C55E" BorderThickness="1">
                  <TextBlock Text="{Binding RemainingBudgetText}" Foreground="#FF22C55E"
                             FontWeight="Bold" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                  <TextBlock Text="Release date" Style="{StaticResource LabelTextStyle}" />
                  <DatePicker Height="38" SelectedDate="{Binding ReleaseDate}" />
                  <TextBlock Text="Use the actual date the assistance is distributed."
                             Margin="0,6,0,0" Style="{StaticResource SmallTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                  <TextBlock Text="Default amount per beneficiary (optional)"
                             Style="{StaticResource LabelTextStyle}" />
                  <TextBox Height="38" Style="{StaticResource StyledTextBoxStyle}"
                           FontSize="15" FontWeight="Bold"
                           Text="{Binding DefaultAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
                  <TextBlock Text="This pre-fills the amount when a resident is selected."
                             Margin="0,6,0,0" Style="{StaticResource SmallTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Margin="0,14,0,0" Style="{StaticResource SummaryCardStyle}">
              <StackPanel>
                <TextBlock Text="Distribution notes" Style="{StaticResource LabelTextStyle}" />
                <TextBox Height="90" Style="{StaticResource StyledTextBoxStyle}" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="9"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Include the purpose, authorization, or source document for the batch."
                           Margin="0,6,0,0" Style="{StaticResource SmallTextStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Step 2: beneficiary verification and staging -->
        <Grid Margin="24,16"
              Visibility="{Binding IsBeneficiaryStep, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.92*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="1.35*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Verify resident" Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock Text="Search the resident registry before adding assistance."
                           Margin="0,4,0,12" Style="{StaticResource SmallTextStyle}" />
                <TextBlock Text="Search name or contact number" Style="{StaticResource LabelTextStyle}" />
                <TextBox Height="36" Style="{StaticResource StyledTextBoxStyle}"
                         Text="{Binding ResidentSearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Margin="0,7,0,0" Height="38" MaxDropDownHeight="320"
                          DisplayMemberPath="DisplayName" Style="{StaticResource StyledComboBoxStyle}"
                          ItemsSource="{Binding ResidentOptions}" SelectedItem="{Binding SelectedResident}" />
                <TextBlock Text="{Binding ResidentSearchStatusText}" Margin="0,5,0,0"
                           Style="{StaticResource SmallTextStyle}" TextWrapping="Wrap" />

                <Border Margin="0,12,0,0" Padding="11,9" CornerRadius="8"
                        BorderThickness="1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBrush}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasBeneficiaryHistoryWarning}" Value="True">
                          <Setter Property="Background" Value="#24F59E0B" />
                          <Setter Property="BorderBrush" Value="#99F59E0B" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Text="Assistance history check" FontWeight="Bold"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    <TextBlock Text="{Binding BeneficiaryHistoryText}" Margin="0,4,0,0"
                               Style="{StaticResource SmallTextStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <TextBlock Text="Amount for this resident (PHP)" Margin="0,14,0,4"
                           Style="{StaticResource LabelTextStyle}" />
                <TextBox Height="40" Style="{StaticResource StyledTextBoxStyle}"
                         FontSize="16" FontWeight="Bold" Foreground="#FF22C55E"
                         Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Height="38" Style="{StaticResource PrimaryButtonStyle}"
                          Background="#FF15803D" BorderBrush="#FF15803D"
                          Content="{Binding StageButtonText}" Command="{Binding StageBeneficiaryCommand}" />
                  <Button Grid.Column="2" Height="38" MinWidth="80"
                          Style="{StaticResource SecondaryButtonStyle}"
                          Content="Clear" Command="{Binding ClearBeneficiaryEntryCommand}" />
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Staged beneficiaries" Style="{StaticResource SectionHeaderTextStyle}" />
                  <TextBlock Text="{Binding BeneficiarySummaryText}" Margin="0,4,0,0"
                             Style="{StaticResource SmallTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Height="34" Padding="10,0" Margin="0,0,7,0"
                          Style="{StaticResource SecondaryButtonStyle}"
                          Content="Apply default to all" Command="{Binding ApplyDefaultAmountCommand}" />
                  <Button Height="34" Padding="10,0" Style="{StaticResource SecondaryButtonStyle}"
                          Content="Remove selected" Command="{Binding RemoveSelectedBeneficiaryCommand}" />
                </StackPanel>
              </Grid>

              <DataGrid Grid.Row="1" Margin="0,12,0,0"
                        Style="{StaticResource StyledDataGridStyle}"
                        ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}"
                        RowStyle="{StaticResource StyledDataGridRowStyle}"
                        CellStyle="{StaticResource StyledDataGridCellStyle}"
                        AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                        RowHeight="42" HeadersVisibility="Column"
                        ItemsSource="{Binding Beneficiaries}" SelectedItem="{Binding SelectedBatchItem}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Beneficiary" Width="2*" Binding="{Binding ResidentName}" />
                  <DataGridTextColumn Header="Contact" Width="1.2*" Binding="{Binding ContactNo}" />
                  <DataGridTextColumn Header="Amount" Width="1*" Binding="{Binding AmountDisplay}" />
                </DataGrid.Columns>
              </DataGrid>

              <Border Grid.Row="2" Margin="0,12,0,0" Padding="11,9" CornerRadius="8"
                      Background="#2022C55E" BorderBrush="#6622C55E" BorderThickness="1">
                <TextBlock Text="{Binding RemainingBudgetText}" Foreground="#FF22C55E"
                           FontWeight="Bold" TextWrapping="Wrap" />
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- Step 3: review -->
        <ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsReviewStep, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                  <TextBlock Text="PROGRAM" FontSize="10" FontWeight="Bold"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                  <TextBlock Text="{Binding ReviewProgramText}" Margin="0,5,0,0"
                             FontWeight="Bold" TextWrapping="Wrap"
                             Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                  <TextBlock Text="{Binding ReviewScheduleText}" Margin="0,4,0,0"
                             Style="{StaticResource SmallTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                  <TextBlock Text="BENEFICIARIES" FontSize="10" FontWeight="Bold"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                  <TextBlock Text="{Binding ReviewBeneficiaryText}" Margin="0,6,0,0"
                             FontSize="16" FontWeight="Bold"
                             Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                  <TextBlock Text="DISTRIBUTION TOTAL" FontSize="10" FontWeight="Bold"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                  <TextBlock Text="{Binding ReviewTotalText}" Margin="0,6,0,0"
                             FontSize="16" FontWeight="Bold" Foreground="#FF22C55E" />
                </StackPanel>
              </Border>
              <Border Grid.Column="6" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                  <TextBlock Text="BUDGET AFTER POST" FontSize="10" FontWeight="Bold"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                  <TextBlock Text="{Binding ReviewBalanceText}" Margin="0,6,0,0"
                             FontSize="16" FontWeight="Bold"
                             Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Margin="0,14,0,0" Style="{StaticResource SummaryCardStyle}">
              <StackPanel>
                <TextBlock Text="Final beneficiary list" Style="{StaticResource SectionHeaderTextStyle}" />
                <DataGrid Margin="0,10,0,0" MaxHeight="260"
                          Style="{StaticResource StyledDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}"
                          RowStyle="{StaticResource StyledDataGridRowStyle}"
                          CellStyle="{StaticResource StyledDataGridCellStyle}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          RowHeight="40" HeadersVisibility="Column" ItemsSource="{Binding Beneficiaries}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Resident" Width="2*" Binding="{Binding ResidentName}" />
                    <DataGridTextColumn Header="Contact" Width="1.25*" Binding="{Binding ContactNo}" />
                    <DataGridTextColumn Header="Amount" Width="1*" Binding="{Binding AmountDisplay}" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="10"
                    Background="#2016A34A" BorderBrush="#6616A34A" BorderThickness="1">
              <StackPanel>
                <CheckBox IsChecked="{Binding IsReviewConfirmed}">
                  <TextBlock Text="I verified the program, resident identities, eligibility history, and all release amounts."
                             FontWeight="Bold" TextWrapping="Wrap"
                             Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                </CheckBox>
                <TextBlock Margin="24,6,0,0"
                           Text="Posting creates permanent release references, deducts the total from the program budget, records the staff action, and generates the batch report."
                           Style="{StaticResource SmallTextStyle}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource ThemeCardBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0"
            Padding="24,12">
      <Grid>
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                Width="90" Height="38" HorizontalAlignment="Left"
                Command="{Binding CancelCommand}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Back to program" Style="{StaticResource SecondaryButtonStyle}"
                  Height="38" MinWidth="120" Margin="0,0,9,0"
                  Command="{Binding BackToProgramCommand}"
                  Visibility="{Binding IsBeneficiaryStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <Button Content="Back to beneficiaries" Style="{StaticResource SecondaryButtonStyle}"
                  Height="38" MinWidth="150" Margin="0,0,9,0"
                  Command="{Binding BackToBeneficiariesCommand}"
                  Visibility="{Binding IsReviewStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <Button Content="Continue to beneficiaries" Style="{StaticResource PrimaryButtonStyle}"
                  Height="38" MinWidth="175"
                  Command="{Binding ContinueToBeneficiariesCommand}"
                  Visibility="{Binding IsProgramStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <Button Content="Review distribution" Style="{StaticResource PrimaryButtonStyle}"
                  Height="38" MinWidth="160"
                  Command="{Binding ContinueToReviewCommand}"
                  Visibility="{Binding IsBeneficiaryStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <Button Content="{Binding SaveButtonText}" Style="{StaticResource PrimaryButtonStyle}"
                  Background="#FF15803D" BorderBrush="#FF15803D"
                  Height="38" MinWidth="170"
                  Command="{Binding SaveReleaseCommand}"
                  Visibility="{Binding IsReviewStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.RowSpan="3" Background="#99000000"
            Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel VerticalAlignment="Center">
        <fa:IconBlock Icon="Spinner" FontSize="42" Foreground="#FF22C55E"
                      HorizontalAlignment="Center">
          <UIElement.RenderTransform>
            <RotateTransform CenterX="21" CenterY="21" />
          </UIElement.RenderTransform>
          <FrameworkElement.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                   From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </FrameworkElement.Triggers>
        </fa:IconBlock>
        <TextBlock Text="{Binding ProcessingMessage}" Margin="0,12,0,0"
                   HorizontalAlignment="Center" Foreground="White" FontWeight="SemiBold" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
