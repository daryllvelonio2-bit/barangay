<Window x:Class="baranggaysystem1.Views.Dialogs.MeetingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Meeting" Width="640" Height="720"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaseWindowStyle}"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource ThemeCardHoverBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Hidden elements referenced by code-behind -->
    <StackPanel Grid.Row="0" Visibility="Collapsed">
      <TextBlock Name="eyebrowText" Text="NEW MEETING" />
      <TextBlock Name="headerTitleText" Text="Schedule a barangay meeting" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="16,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Row 0: Title -->
      <StackPanel Grid.Row="0" Margin="0,0,0,8">
        <TextBlock Text="Meeting Title" Style="{StaticResource LabelTextStyle}" />
        <TextBox Name="txtTitle" Style="{StaticResource StyledTextBoxStyle}" MaxLength="200" />
      </StackPanel>

      <!-- Row 1: Type + Status -->
      <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Meeting Type" Style="{StaticResource LabelTextStyle}" />
          <ComboBox Name="typeCombo" Style="{StaticResource StyledComboBoxStyle}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Status" Style="{StaticResource LabelTextStyle}" />
          <ComboBox Name="statusCombo" Style="{StaticResource StyledComboBoxStyle}" />
        </StackPanel>
      </Grid>

      <!-- Row 2: Date + Time -->
      <Grid Grid.Row="2" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Date" Style="{StaticResource LabelTextStyle}" />
          <DatePicker Name="dpDate" Height="30" Padding="2" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Time (HH:MM, 24-hour)" Style="{StaticResource LabelTextStyle}" />
          <TextBox Name="txtTime" Style="{StaticResource StyledTextBoxStyle}" MaxLength="5" Text="09:00" />
        </StackPanel>
      </Grid>

      <!-- Row 3: Venue -->
      <StackPanel Grid.Row="3" Margin="0,0,0,8">
        <TextBlock Text="Venue" Style="{StaticResource LabelTextStyle}" />
        <TextBox Name="txtVenue" Style="{StaticResource StyledTextBoxStyle}" MaxLength="200" />
      </StackPanel>

      <!-- Row 4: Agenda -->
      <StackPanel Grid.Row="4" Margin="0,0,0,8">
        <TextBlock Text="Agenda" Style="{StaticResource LabelTextStyle}" />
        <TextBox Name="txtAgenda" Style="{StaticResource StyledTextBoxStyle}" Height="70"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="6" />
      </StackPanel>

      <!-- Row 5: Minutes (fills remaining) -->
      <StackPanel Grid.Row="5" Margin="0,0,0,8">
        <TextBlock Text="Minutes / Summary" Style="{StaticResource LabelTextStyle}" />
        <TextBox Name="txtMinutes" Style="{StaticResource StyledTextBoxStyle}" Height="70"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="6" />
      </StackPanel>

      <!-- Row 6: Attendance + Quorum -->
      <Grid Grid.Row="6" Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Attendance Count" Style="{StaticResource LabelTextStyle}" />
          <TextBox Name="txtAttendance" Style="{StaticResource StyledTextBoxStyle}" Text="0" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
          <CheckBox Name="chkQuorum" Content="Quorum reached" FontSize="11" />
        </StackPanel>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="32"
                Margin="0,0,10,0" IsCancel="True" />
        <Button Name="btnSave" Content="Save Meeting" Style="{StaticResource PrimaryButtonStyle}"
                Width="140" Height="32" IsDefault="True" Click="BtnSave_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
