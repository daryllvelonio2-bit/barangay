<Window x:Class="baranggaysystem1.Views.Dialogs.StaffDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="500" Height="580" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1" Title="{Binding Title}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="16,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- System Credentials -->
      <TextBlock Grid.Row="0" Text="System Credentials" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,6" />

      <StackPanel Grid.Row="1" Margin="0,0,0,6">
        <TextBlock Text="Username (Login ID)" Style="{StaticResource LabelTextStyle}" />
        <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNewUser}" />
      </StackPanel>

      <ContentControl Grid.Row="2" Margin="0,0,0,6" Visibility="{Binding IsNewUser, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border Background="{DynamicResource ThemeCardHoverBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
          <StackPanel>
            <TextBlock Text="Initial Temporary Password" Style="{StaticResource SmallTextStyle}" />
            <TextBox IsReadOnly="True" Background="Transparent" BorderThickness="0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding TemporaryPassword}" />
            <TextBlock Text="The user must change this on first login." Style="{StaticResource SmallTextStyle}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
          </StackPanel>
        </Border>
      </ContentControl>

      <!-- Personal Details -->
      <TextBlock Grid.Row="3" Text="Personal Details" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,6,0,6" />

      <Grid Grid.Row="4" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="First Name" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Last Name" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="5" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Middle Name" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Email Address" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="6" Margin="0,0,0,6">
        <TextBlock Text="Contact Number" Style="{StaticResource LabelTextStyle}" />
        <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>

      <!-- Organizational Role -->
      <TextBlock Grid.Row="7" Text="Organizational Role" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,6,0,6" />

      <Grid Grid.Row="8" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Position" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Department" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Text="System Role" Style="{StaticResource LabelTextStyle}" />
          <ComboBox Style="{StaticResource StyledComboBoxStyle}" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding RoleName}" />
        </StackPanel>
      </Grid>

      <CheckBox Grid.Row="9" Content="Account is Active (can login)" Margin="0,4,0,0" FontSize="11" IsChecked="{Binding IsActive}" />
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource ThemeCardHoverBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="32" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
        <Button Content="Save Staff Profile" Style="{StaticResource PrimaryButtonStyle}" Width="140" Height="32" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
