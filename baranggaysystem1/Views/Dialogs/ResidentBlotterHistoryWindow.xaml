<Window x:Class="baranggaysystem1.Views.Dialogs.ResidentBlotterHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Blotter Case History" Width="920" Height="580" MinWidth="700" MinHeight="400" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Style="{StaticResource BaseWindowStyle}" Background="{DynamicResource ThemeCardHoverBrush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="HistoryStatusBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="10,3" />
        <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
          <Trigger Property="FrameworkElement.Tag" Value="OPEN">
            <Setter Property="Background" Value="{DynamicResource ThemeSelectionSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSelectionBorderBrush}" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="ONGOING">
            <Setter Property="Background" Value="{DynamicResource ReminderAttentionBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ReminderAttentionBorderBrush}" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="SETTLED">
            <Setter Property="Background" Value="{DynamicResource ReminderPlanBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ReminderPlanBorderBrush}" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="REFERRED">
            <Setter Property="Background" Value="{DynamicResource ThemeSelectionSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSelectionBorderBrush}" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="CLOSED">
            <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="HistoryStatusTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Style.Triggers>
          <Trigger Property="FrameworkElement.Tag" Value="OPEN">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="ONGOING">
            <Setter Property="Foreground" Value="{DynamicResource ReminderAttentionAccentBrush}" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="SETTLED">
            <Setter Property="Foreground" Value="{DynamicResource ReminderPlanAccentBrush}" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="REFERRED">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="CLOSED">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="InvolvementBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="Border.Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource ThemeCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
          <Trigger Property="FrameworkElement.Tag" Value="Complainant">
            <Setter Property="Background" Value="{DynamicResource ThemeSelectionSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSelectionBorderBrush}" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="Respondent">
            <Setter Property="Background" Value="{DynamicResource ReminderUrgentBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ReminderUrgentBorderBrush}" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="Both">
            <Setter Property="Background" Value="{DynamicResource ReminderAttentionBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ReminderAttentionBorderBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="InvolvementTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SmallTextStyle}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Style.Triggers>
          <Trigger Property="FrameworkElement.Tag" Value="Complainant">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="Respondent">
            <Setter Property="Foreground" Value="{DynamicResource ReminderUrgentAccentBrush}" />
          </Trigger>
          <Trigger Property="FrameworkElement.Tag" Value="Both">
            <Setter Property="Foreground" Value="{DynamicResource ReminderAttentionAccentBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="24,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal">
            <Border Width="32" Height="32" CornerRadius="8" Background="#FFFEE2E2" Margin="0,0,12,0">
              <fa:IconBlock Icon="Gavel" Foreground="#FFDC2626" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Blotter Case History" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontFamily="{StaticResource CenturyGothic}" />
              <TextBlock Name="residentNameLabel" Text="Resident Name" Style="{StaticResource SubtitleTextStyle}" Margin="0,2,0,0" FontWeight="SemiBold" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Padding="4" Foreground="{DynamicResource ThemeTextMutedBrush}" VerticalAlignment="Top" Click="BtnClose_Click">
          <fa:IconBlock Icon="Times" FontSize="14" />
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource ThemeGridRowAltBgBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Column="0">
          <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="Total Cases" Style="{StaticResource SmallTextStyle}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              <TextBlock Name="totalCasesValue" Text="0" Style="{StaticResource HeadingTextStyle}" FontSize="16" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="#FF93C5FD" BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="Active" Style="{StaticResource SmallTextStyle}" FontSize="10" FontWeight="SemiBold" Foreground="#FF2563EB" />
              <TextBlock Name="activeCasesValue" Text="0" Style="{StaticResource HeadingTextStyle}" FontSize="16" Foreground="#FF2563EB" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="#FF86EFAC" BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="Settled" Style="{StaticResource SmallTextStyle}" FontSize="10" FontWeight="SemiBold" Foreground="#FF15803D" />
              <TextBlock Name="settledCasesValue" Text="0" Style="{StaticResource HeadingTextStyle}" FontSize="16" Foreground="#FF15803D" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Text="As Complainant" Style="{StaticResource SmallTextStyle}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              <TextBlock Name="complainantCountValue" Text="0" Style="{StaticResource HeadingTextStyle}" FontSize="16" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="#FFFCA5A5" BorderThickness="1" CornerRadius="10" Padding="12,6" Margin="0,0,0,0">
            <StackPanel>
              <TextBlock Text="As Respondent" Style="{StaticResource SmallTextStyle}" FontSize="10" FontWeight="SemiBold" Foreground="#FFDC2626" />
              <TextBlock Name="respondentCountValue" Text="0" Style="{StaticResource HeadingTextStyle}" FontSize="16" Foreground="#FFDC2626" />
            </StackPanel>
          </Border>
        </WrapPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="Time Filter" Style="{StaticResource SmallTextStyle}" Margin="0,0,0,4" FontWeight="SemiBold" />
          <ComboBox Name="timeFilterCombo" Width="140" Style="{StaticResource StyledComboBoxStyle}" Height="32" SelectionChanged="TimeFilterCombo_SelectionChanged">
            <ComboBoxItem Content="All Time" IsSelected="True" />
            <ComboBoxItem Content="This Week" />
            <ComboBoxItem Content="This Month" />
            <ComboBoxItem Content="This Year" />
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Row="2" Margin="20,14,20,0">
      <Border Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid>
          <DataGrid Name="casesGrid" Style="{StaticResource StyledDataGridStyle}" ColumnHeaderStyle="{StaticResource StyledDataGridColumnHeaderStyle}" RowStyle="{StaticResource StyledDataGridRowStyle}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="46" HeadersVisibility="Column" CanUserAddRows="False" Margin="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Case No." Width="1.2*" ElementStyle="{StaticResource BodyTextStyle}" Binding="{Binding case_no}" />
              <DataGridTemplateColumn Header="Role" Width="0.8*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource InvolvementBadgeStyle}" HorizontalAlignment="Left" Tag="{Binding involvement}">
                      <TextBlock Style="{StaticResource InvolvementTextStyle}" Text="{Binding involvement}" Tag="{Binding involvement}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Complainant" Width="1.3*" ElementStyle="{StaticResource BodyTextStyle}" Binding="{Binding complainant_name}" />
              <DataGridTextColumn Header="Respondent" Width="1.3*" ElementStyle="{StaticResource BodyTextStyle}" Binding="{Binding respondent_name}" />
              <DataGridTextColumn Header="Type" Width="1*" ElementStyle="{StaticResource BodyTextStyle}" Binding="{Binding incident_type}" />
              <DataGridTextColumn Header="Date" Width="0.8*" ElementStyle="{StaticResource BodyTextStyle}" Binding="{Binding incident_date}" />
              <DataGridTemplateColumn Header="Status" Width="0.85*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource HistoryStatusBadgeStyle}" HorizontalAlignment="Left" Tag="{Binding status}">
                      <TextBlock Style="{StaticResource HistoryStatusTextStyle}" Text="{Binding status}" Tag="{Binding status}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Name="emptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <fa:IconBlock Icon="CheckCircle" FontSize="48" Foreground="#FF86EFAC" HorizontalAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="No blotter cases found" Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="This resident has no recorded blotter case involvement." Style="{StaticResource SmallTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Name="loadingState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
            <fa:IconBlock Icon="Spinner" FontSize="24" Foreground="{DynamicResource ThemeTextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="Loading blotter cases..." Style="{StaticResource SmallTextStyle}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" Margin="20,12,20,16" Padding="16,12" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Name="footerLabel" Text="Loading..." Style="{StaticResource SmallTextStyle}" FontWeight="SemiBold" />
          <TextBlock Text="Cases where this resident appears as complainant or respondent." Style="{StaticResource SmallTextStyle}" Margin="0,3,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Height="32" MinWidth="0" Padding="12,0" FontSize="11" Click="BtnClose_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="Times" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Close" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
