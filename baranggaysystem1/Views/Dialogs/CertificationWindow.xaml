<Window x:Class="baranggaysystem1.Views.Dialogs.CertificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Width="640" Height="720" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{DynamicResource ThemeCardHoverBrush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1" Title="{Binding WindowTitle}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="16,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Resident picker (conditional) -->
      <StackPanel Grid.Row="0" Margin="0,0,0,8" Visibility="{Binding ShowResidentPicker, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Resident" Style="{StaticResource LabelTextStyle}" />
        <ComboBox DisplayMemberPath="DisplayName" Style="{StaticResource StyledComboBoxStyle}" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName" ItemsSource="{Binding ResidentOptions}" SelectedItem="{Binding SelectedResident}" />
      </StackPanel>

      <!-- Document Type -->
      <StackPanel Grid.Row="1" Margin="0,0,0,8">
        <TextBlock Text="Document Type" Style="{StaticResource LabelTextStyle}" />
        <ComboBox DisplayMemberPath="Name" Style="{StaticResource StyledComboBoxStyle}" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" ItemsSource="{Binding CertificationTypes}" SelectedItem="{Binding SelectedType}" />
      </StackPanel>

      <!-- Purpose -->
      <StackPanel Grid.Row="2" Margin="0,0,0,8">
        <TextBlock Text="Purpose" Style="{StaticResource LabelTextStyle}" />
        <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="6" Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>

      <!-- Business Details (conditional) -->
      <Grid Grid.Row="3" Margin="0,0,0,8" Visibility="{Binding IsBusinessType, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Business Name" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Business Nature" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding BusinessNature, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>

      <!-- Fee + OR Number -->
      <Grid Grid.Row="4" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Processing Fee (PHP)" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding Fee, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="O.R. Number" Style="{StaticResource LabelTextStyle}" />
          <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding OrNumber, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>

      <!-- Payment Method + Issue Date -->
      <Grid Grid.Row="5" Visibility="{Binding ShowPaymentFields, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Payment Method" Style="{StaticResource LabelTextStyle}" />
          <ComboBox Style="{StaticResource StyledComboBoxStyle}" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Issue Date" Style="{StaticResource LabelTextStyle}" />
          <DatePicker Height="30" Padding="2" SelectedDate="{Binding IssuedDate}" />
        </StackPanel>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="90" Height="30" Margin="0,0,10,0" IsCancel="True" />
        <Button Style="{StaticResource PrimaryButtonStyle}" Width="140" Height="30" Content="{Binding ActionButtonText}" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Border>

    <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
      <StackPanel VerticalAlignment="Center">
        <fa:IconBlock Icon="Spinner" FontSize="30" Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Center">
          <UIElement.RenderTransform>
            <RotateTransform CenterX="15" CenterY="15" />
          </UIElement.RenderTransform>
          <FrameworkElement.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </FrameworkElement.Triggers>
        </fa:IconBlock>
        <TextBlock Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" Margin="0,8,0,0" Text="{Binding LoadingMessage}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
