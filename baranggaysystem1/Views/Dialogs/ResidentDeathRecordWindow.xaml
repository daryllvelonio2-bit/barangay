<Window x:Class="baranggaysystem1.Views.Dialogs.ResidentDeathRecordWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Record Resident Death" Width="720" Height="620" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Background="{StaticResource Slate900Brush}" Padding="20,14">
      <StackPanel>
        <TextBlock Name="stepTitle" Text="1. Select resident" Foreground="White" FontSize="17" FontWeight="Bold" />
        <TextBlock Name="stepHint" Text="Find the active resident whose record must be updated." Foreground="#FFCBD5E1" Margin="0,3,0,0" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Margin="24,18">
      <StackPanel Name="residentStep">
        <TextBlock Text="Resident" Style="{StaticResource LabelTextStyle}" />
        <ComboBox Name="residentCombo" Height="40" DisplayMemberPath="DisplayName" Style="{StaticResource StyledComboBoxStyle}" />
        <TextBlock Text="Only active residents are available. Search and identity details remain in the resident registry." Style="{StaticResource SmallTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Name="detailsStep" Visibility="Collapsed">
        <TextBlock Text="Date of death" Style="{StaticResource LabelTextStyle}" />
        <DatePicker Name="deathDatePicker" Height="38" Margin="0,0,0,12" />
        <TextBlock Text="Place of death" Style="{StaticResource LabelTextStyle}" />
        <TextBox Name="placeBox" Height="38" Margin="0,0,0,12" />
        <TextBlock Text="Cause of death" Style="{StaticResource LabelTextStyle}" />
        <TextBox Name="causeBox" Height="38" Margin="0,0,0,12" />
        <TextBlock Text="Death certificate / supporting reference" Style="{StaticResource LabelTextStyle}" />
        <TextBox Name="referenceBox" Height="38" Margin="0,0,0,12" />
        <TextBlock Text="Reported or verified by" Style="{StaticResource LabelTextStyle}" />
        <TextBox Name="reportedByBox" Height="38" Margin="0,0,0,12" />
        <TextBlock Text="Notes" Style="{StaticResource LabelTextStyle}" />
        <TextBox Name="notesBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Name="reviewStep" Visibility="Collapsed">
        <TextBlock Text="Review before confirming" Style="{StaticResource SectionHeaderTextStyle}" />
        <TextBlock Name="reviewText" Margin="0,14,0,18" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="14" LineHeight="24" />
        <CheckBox Name="verifiedCheck" Content="I verified the resident identity and supporting death record." Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="SemiBold" />
        <Border Background="{DynamicResource ThemeCardHoverBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,18,0,0">
          <TextBlock Text="Confirming changes the resident status to DECEASED. Corrections require a recorded reason and permission." TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
        </Border>
      </StackPanel>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource ThemeCardHoverBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid>
        <Button Name="backButton" Content="Back" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" Click="Back_Click" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Margin="0,0,8,0" />
          <Button Name="nextButton" Content="Continue" Style="{StaticResource PrimaryButtonStyle}" Click="Next_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
