<Window x:Class="baranggaysystem1.Views.Dialogs.ResidentClassificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Title="Tag or Category" Width="420" Height="380" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{DynamicResource ThemeCardHoverBrush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Hidden elements referenced by code-behind -->
    <TextBlock Name="eyebrowText" Visibility="Collapsed" />
    <TextBlock Name="headerTitleText" Visibility="Collapsed" />
    <TextBlock Name="headerSubtitleText" Visibility="Collapsed" />

    <Grid Grid.Row="0" Margin="28,24" MaxWidth="900" HorizontalAlignment="Center" VerticalAlignment="Top">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Type + Status -->
      <Grid Grid.Row="0" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Type" Style="{StaticResource LabelTextStyle}" />
          <ComboBox Name="typeComboBox" Style="{StaticResource StyledComboBoxStyle}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Status" Style="{StaticResource LabelTextStyle}" />
          <ComboBox Name="statusComboBox" Style="{StaticResource StyledComboBoxStyle}" />
        </StackPanel>
      </Grid>

      <!-- Name -->
      <StackPanel Grid.Row="1" Margin="0,0,0,8">
        <TextBlock Text="Name" Style="{StaticResource LabelTextStyle}" />
        <TextBox Name="nameTextBox" Style="{StaticResource StyledTextBoxStyle}" MaxLength="100" />
      </StackPanel>

      <!-- Description -->
      <StackPanel Grid.Row="2" Margin="0,0,0,8">
        <TextBlock Text="Description" Style="{StaticResource LabelTextStyle}" />
        <TextBox Name="descriptionTextBox" Style="{StaticResource StyledTextBoxStyle}" Height="60" MaxLength="255" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="6" />
      </StackPanel>

      <!-- Color -->
      <Grid Grid.Row="3" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="36" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Color" Style="{StaticResource LabelTextStyle}" />
          <ComboBox Name="colorComboBox" Style="{StaticResource StyledComboBoxStyle}" SelectionChanged="ColorComboBox_SelectionChanged" />
        </StackPanel>
        <Border Name="colorPreview" Grid.Column="1" Height="30" Width="30" Margin="6,16,0,0" CornerRadius="6" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" VerticalAlignment="Bottom" />
      </Grid>

      <!-- System notice -->
      <Border Name="systemNotice" Grid.Row="4" Visibility="Collapsed" Padding="10" Background="#333B82F6" CornerRadius="6" BorderBrush="#DBEAFE" BorderThickness="1">
        <DockPanel>
          <fa:IconBlock Icon="InfoCircle" Foreground="#3B82F6" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Top" />
          <TextBlock Text="System category. Type is locked and cannot be deleted." Foreground="#60A5FA" FontSize="11" TextWrapping="Wrap" />
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True" />
        <Button Name="saveButton" Content="Save" Style="{StaticResource PrimaryButtonStyle}" Width="100" Height="30" IsDefault="True" Click="SaveButton_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
