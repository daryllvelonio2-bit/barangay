<Window x:Class="baranggaysystem1.Views.Dialogs.WelcomeSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Welcome to Barangay Management System"
        Width="820" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="16" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.12" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Branding -->
            <Border Grid.Column="0" CornerRadius="16,0,0,16" Background="#1E293B">
                <StackPanel VerticalAlignment="Center" Margin="32">
                    <Border Width="72" Height="72" CornerRadius="20" Background="#334155" Margin="0,0,0,24">
                        <fa:IconBlock Icon="Landmark" Foreground="#60A5FA" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Barangay" FontSize="28" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Management System" FontSize="28" FontWeight="Light" Foreground="#94A3B8" Margin="0,0,0,16" />
                    <TextBlock Text="A modern, all-in-one platform for barangay governance, resident records, documents, blotter cases, and community services." 
                               TextWrapping="Wrap" FontSize="12" Foreground="#94A3B8" LineHeight="20" />
                    <Border Margin="0,28,0,0" Padding="12,8" Background="#334155" CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="ShieldAlt" FontSize="12" Foreground="#60A5FA" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Secure • Offline-capable • Fast" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right Panel - Setup Steps -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="32,28,32,0">
                    <TextBlock Text="Welcome! Let's get started." FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    <TextBlock Text="Here's what you need to know about your new system." FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Content -->
                <ScrollViewer Grid.Row="1" Margin="32,20,32,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Feature 1 -->
                        <Border Margin="0,0,0,12" Padding="14" Background="{DynamicResource ThemeCardHoverBrush}" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="#DBEAFE">
                                    <fa:IconBlock Icon="Users" FontSize="14" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Resident Records" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                    <TextBlock Text="Manage household profiles, demographics, and classifications (PWD, senior, 4Ps, voters)." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Feature 2 -->
                        <Border Margin="0,0,0,12" Padding="14" Background="{DynamicResource ThemeCardHoverBrush}" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="#FEF3C7">
                                    <fa:IconBlock Icon="FileContract" FontSize="14" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Certificates &amp; Clearances" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                    <TextBlock Text="Issue barangay clearances, residency certificates, and business permits with auto-tracking." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Feature 3 -->
                        <Border Margin="0,0,0,12" Padding="14" Background="{DynamicResource ThemeCardHoverBrush}" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="#FEE2E2">
                                    <fa:IconBlock Icon="Gavel" FontSize="14" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Blotter &amp; Case Management" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                    <TextBlock Text="Record incidents, schedule mediations, track case timelines, and generate reports." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Feature 4 -->
                        <Border Margin="0,0,0,12" Padding="14" Background="{DynamicResource ThemeCardHoverBrush}" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="#DCFCE7">
                                    <fa:IconBlock Icon="HandHoldingHeart" FontSize="14" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Ayuda &amp; Financial Operations" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                    <TextBlock Text="Distribute assistance, track payments, and manage barangay finances with audit trails." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Feature 5 -->
                        <Border Margin="0,0,0,12" Padding="14" Background="{DynamicResource ThemeCardHoverBrush}" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="#EDE9FE">
                                    <fa:IconBlock Icon="CalendarCheck" FontSize="14" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Governance &amp; Operations" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                    <TextBlock Text="Meetings, resolutions, tanod patrol, facility bookings, and emergency contacts." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Quick Info -->
                        <Border Margin="0,4,0,0" Padding="12,10" Background="#333B82F6" CornerRadius="8" BorderBrush="#BFDBFE" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="InfoCircle" FontSize="13" Foreground="#2563EB" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Default admin account: Admin1 / Admin1. Change your password after first login." FontSize="11" Foreground="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Margin="32,16,32,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Name="chkDontShowAgain" Content="Don't show this again" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" IsChecked="True" />
                        <Button Name="btnGetStarted" Grid.Column="1" Content="Get Started →" FontSize="13" FontWeight="SemiBold" Foreground="White" Background="#2563EB" BorderBrush="#2563EB" Padding="24,10" Cursor="Hand" Click="BtnGetStarted_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
