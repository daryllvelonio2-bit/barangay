<Window x:Class="baranggaysystem1.Views.Dialogs.AyudaProgramWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp" Width="560" Height="700" WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindowStyle}" ShowInTaskbar="False" ResizeMode="NoResize" Background="{DynamicResource ThemeCardHoverBrush}" xmlns:dialogs="clr-namespace:baranggaysystem1.Views.Dialogs;assembly=baranggaysystem1" Title="{Binding WindowTitle}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Visibility="Collapsed">
      <TextBlock Foreground="#FFFFFFFF" FontSize="14" FontWeight="Black" VerticalAlignment="Center" Text="{Binding HeaderEyebrowText}" />
      <TextBlock Foreground="#FFFFFFFF" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource CenturyGothic}" Text="{Binding HeaderTitleText}" />
      <TextBlock Foreground="#DBEAFE" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding HeaderDescriptionText}" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="16,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Program Name -->
      <StackPanel Grid.Row="0" Margin="0,0,0,8">
        <TextBlock Text="Program Name" Style="{StaticResource LabelTextStyle}" />
        <TextBox Style="{StaticResource StyledTextBoxStyle}" Text="{Binding ProgramName, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>

      <!-- Category + Status -->
      <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Category" Style="{StaticResource LabelTextStyle}" />
          <ComboBox IsEditable="True" Style="{StaticResource StyledComboBoxStyle}" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Program Status" Style="{StaticResource LabelTextStyle}" />
          <ComboBox Style="{StaticResource StyledComboBoxStyle}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" />
        </StackPanel>
      </Grid>

      <!-- Budget -->
      <StackPanel Grid.Row="2" Margin="0,0,0,8">
        <TextBlock Text="Allocated Budget (PHP)" Style="{StaticResource LabelTextStyle}" />
        <TextBox Style="{StaticResource StyledTextBoxStyle}" FontSize="14" FontWeight="Bold" Foreground="#60A5FA" Text="{Binding AllocatedBudget, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
      </StackPanel>

      <!-- Start + End Date -->
      <Grid Grid.Row="3" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Start Date" Style="{StaticResource LabelTextStyle}" />
          <DatePicker Height="30" Padding="2" SelectedDate="{Binding StartDate}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="End Date" Style="{StaticResource LabelTextStyle}" />
          <DatePicker Height="30" Padding="2" SelectedDate="{Binding EndDate}" />
        </StackPanel>
      </Grid>

      <!-- Notes -->
      <StackPanel Grid.Row="4" Margin="0,0,0,0">
        <TextBlock Text="Program Notes" Style="{StaticResource LabelTextStyle}" />
        <TextBox Style="{StaticResource StyledTextBoxStyle}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="6" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="40" Margin="0,0,12,0" IsCancel="True" />
        <Button Style="{StaticResource PrimaryButtonStyle}" Width="190" Height="40" Content="{Binding SaveButtonText}" Command="{Binding SaveProgramCommand}" />
      </StackPanel>
    </Border>
    <Border Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel VerticalAlignment="Center">
        <fa:IconBlock Icon="Spinner" FontSize="40" Foreground="#60A5FA" HorizontalAlignment="Center">
          <UIElement.RenderTransform>
            <RotateTransform CenterX="20" CenterY="20" />
          </UIElement.RenderTransform>
          <FrameworkElement.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </FrameworkElement.Triggers>
        </fa:IconBlock>
        <TextBlock Text="Saving ayuda program..." Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>